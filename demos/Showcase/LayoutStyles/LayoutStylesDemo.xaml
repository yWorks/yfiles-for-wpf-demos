<demo:Demo x:Class="yWorks.Demo.LayoutStyles.LayoutStylesDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
    xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
    xmlns:optionHandler="clr-namespace:yWorks.Demo.Toolkit.OptionHandler;assembly=option-handler">
    <demo:DemoView>
        <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
            <DockPanel>
                <demo:DemoToolBar DockPanel.Dock="Top"  ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
                    <Button Command="New" CommandTarget="{Binding ElementName=graphControl}" x:Name="NewButton"/>
                    <Button Command="Open" CommandTarget="{Binding ElementName=graphControl}" x:Name="OpenButton" />
                    <Button Command="SaveAs" CommandTarget="{Binding ElementName=graphControl}" x:Name="SaveAsButton"/>
                    <Separator />
                    <Button Command="Cut" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Button Command="Copy" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Button Command="Paste" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Button Command="Delete" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Separator />
                    <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Separator />
                    <ToggleButton IsChecked="False" ToolTip="Snapping" Click="ToggleSnapLines" Content="{StaticResource IconSnap}"/>
                    <ToggleButton IsChecked="False" ToolTip="Enable Orthogonal Edges" Click="ToggleOrthogonalEdges" Content="{StaticResource IconOrthogonalEditing}"/>
                    <Separator />
                    <Button Command="{x:Static ywpf:GraphCommands.GroupSelection}" CommandTarget="{Binding ElementName=graphControl}" />
                    <Button Command="{x:Static ywpf:GraphCommands.UngroupSelection}" CommandTarget="{Binding ElementName=graphControl}" />
                    <Separator />
                    <Button Content="{StaticResource IconNodeLabel}" ToolTip="Generate random node labels" Click="GenerateRandomNodeLabels" />
                    <Button Content="{StaticResource IconEdgeLabel}" ToolTip="Generate random edge labels" Click="GenerateRandomEdgeLabels" />
                    <Button Content="{StaticResource IconClose}" ToolTip="Remove all labels" Click="RemoveAllLabels" />
                    <Separator />
                    <Button x:Name="GenerateRandomEdgeThicknessButton" Content="{StaticResource IconEdgeThickness}" ToolTip="Generate random edge thickness" Click="GenerateRandomEdgeThickness" />
                    <Button x:Name="ResetAllEdgeThicknessButton" Content="{StaticResource IconClose}" ToolTip="Reset all edge thickness" Click="ResetEdgeThickness" />
                    <Separator />
                    <Button x:Name="GenerateRandomEdgeDirectionsButton" Content="{StaticResource IconEdgeDirection}" ToolTip="Generate random edge directions" Click="GenerateRandomEdgeDirectedness" />
                    <Button x:Name="ResetAllEdgeDirectionsButton" Content="{StaticResource IconClose}" ToolTip="Reset all edge directions" Click="ResetEdgeDirectedness" />
                </demo:DemoToolBar>
                <ywpf:GraphControl x:Name="graphControl" />
            </DockPanel>
        </demo:ClippingBorder>

        <demo:SideBar Header="Interaction">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="8, 8, 8, 25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontSize="24" FontWeight="SemiBold"
                           Margin="0, 0, 0, 10">
                        Layout Algorithm
                    </Label>
                    <Button Grid.Row="1" Grid.Column="0" Padding="2, 0" Click="PreviousLayout_OnClick"
                            x:Name="PreviousLayoutButton"
                            Content="&#xE72B;"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            FontSize="16"
                            MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                            VerticalAlignment="Stretch" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="2, 0"
                              x:Name="LayoutComboBox" DisplayMemberPath="Name" SelectedIndex="0"
                              SelectionChanged="OnLayoutChanged" />
                    <Button Grid.Row="1" Grid.Column="2" Padding="2, 0" Click="NextLayout_OnClick"
                            x:Name="NextLayoutButton"
                            Content="&#xE72A;"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            FontSize="16"
                            MinWidth="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                            VerticalAlignment="Stretch" />
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" FontSize="24" FontWeight="SemiBold"
                           Margin="0, 10, 0, 10">
                        Sample Graph
                    </Label>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="2, 0"
                              x:Name="SampleComboBox" DisplayMemberPath="Name" SelectedIndex="0"
                              SelectionChanged="OnSampleChanged" />
                </Grid>
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Padding>
                        <Thickness Left="0" Top="0" Right="{x:Static SystemParameters.VerticalScrollBarWidth}" Bottom="0"/>
                    </ScrollViewer.Padding>
                    <optionHandler:ConfigurationEditor x:Name="Editor" Configuration="{Binding ElementName=LayoutComboBox, Path=SelectedItem.Configuration}" Style="{x:Null}"/>
                </ScrollViewer>
                <Button x:Name="ApplyButton" Height="40" FontSize="18" Style="{DynamicResource AccentButtonStyle}" Click="ApplyButtonClick" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10">Apply</Button>
                <Button x:Name="ResetButton" Height="40" FontSize="18" Click="ResetButtonClick" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10">Reset</Button>
            </Grid>
        </demo:SideBar>
        <demo:Description Source="description.html" />
    </demo:DemoView>
</demo:Demo>
