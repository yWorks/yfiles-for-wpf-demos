<demo:Demo x:Class="yWorks.Demo.LargeGraphs.LargeGraphsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:local="clr-namespace:yWorks.Demo.LargeGraphs"
           DataContext="{Binding PerformanceSettings, RelativeSource={RelativeSource Self}, Mode=TwoWay}">
  <demo:Demo.Resources>
      <local:BooleanNegationConverter x:Key="BooleanNegationConverter" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ResourceKey={x:Static SystemColors.ControlDarkColorKey}}"/>
      <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource ResourceKey={x:Static SystemColors.ControlDarkColorKey}}"/>
      <SolidColorBrush x:Key="HeaderForegroundBrush" Color="{StaticResource ResourceKey={x:Static SystemColors.ControlLightLightColorKey}}"/>

      <DataTemplate x:Key="RotateIcon">
          <Viewbox Stretch="Uniform">
              <Canvas Width="64" Height="64">
                  <Path Fill="White" StrokeThickness="1.5" Stroke="{StaticResource PrimaryBrush}" Data="m 32 6.0042738 c -14.305631 0 -25.9812922 11.7045292 -25.9812922 26.0101602 0 14.305631 11.6756612 25.981292 25.9812922 25.981292 14.305631 0 25.981292 -11.675661 25.981292 -25.981292 l -8.314013 0 c 0 9.812405 -7.854874 17.667279 -17.667279 17.667279 -9.812405 0 -17.667279 -7.854874 -17.667279 -17.667279 0 -9.812405 7.854874 -17.696147 17.667279 -17.696147 3.862455 0 7.546507 1.28368 10.565725 3.550777 L 39.823256 19.976435 52.424945 22.901741 53.015979 9.8725995 49.34973 12.701674 C 44.620298 8.4439323 38.469554 6.0042738 32 6.0042738 z"/>
              </Canvas>
          </Viewbox>
      </DataTemplate>
      <DataTemplate x:Key="ZoomIcon">
          <Viewbox Stretch="Uniform">
              <Canvas Width="64" Height="64">
                  <Path Fill="White" StrokeThickness="1.5" Stroke="{StaticResource PrimaryBrush}" Data="m 32.173292 2.4918554 c 0 0 -10.022672 5.90499 -10.022672 5.90499 0 0 4.994041 0.01147 4.994041 0.01147 0 0 -7.003383 36.0945106 -7.003383 36.0945106 0 0 -11.7811574 -0.06402 -11.7811574 -0.06402 0 0 23.3218474 17.069337 23.3218474 17.069337 0 0 23.957911 -16.818923 23.957911 -16.818923 0 0 -11.858798 -0.0644 -11.858798 -0.0644 0 0 -6.635341 -36.193535 -6.635341 -36.193535 0 0 5.004447 0.011501 5.004447 0.011501 0 0 -9.976895 -5.9509323 -9.976895 -5.9509323"/>
              </Canvas>
          </Viewbox>
      </DataTemplate>
      <DataTemplate x:Key="SpiralZoomIcon">
          <Viewbox Stretch="Uniform">
              <Canvas Width="64" Height="64">
                  <Path Fill="White" StrokeThickness="1.5" Stroke="{StaticResource PrimaryBrush}" Data="m 20.027658 30.466513 c 1.673406 3.215045 6.162171 3.947451 9.416327 2.400931 4.899943 -2.328676 6.006917 -8.2175 3.546529 -12.452279 -3.56982 -6.144313 -12.342975 -7.44977 -18.648804 -4.178484 -8.8703711 4.6017 -10.7606702 15.47465 -5.9152371 23.22535 6.6396701 10.620744 22.0789981 12.759686 33.0838691 6.692996 6.513638 -3.590795 11.172082 -9.617345 13.069219 -16.360875 l 3.596923 0.284906 -9.754136 -12.920611 -11.389992 11.143488 3.581825 0.284824 c 0 0 -3.534659 6.885415 -7.046706 8.821511 -5.933641 3.271058 -14.25827 2.117776 -17.83827 -3.608751 -2.612576 -4.179048 -1.593359 -10.041562 3.189399 -12.522721 3.399996 -1.763823 8.130336 -1.059943 10.055123 2.252968 1.3266 2.283323 0.729738 5.458479 -1.912229 6.714061 -1.754587 0.833859 -4.174855 0.438957 -5.077126 -1.294541 -0.572703 -1.100311 -0.283037 -2.631743 1.01117 -3.167464 l 0.956491 1.057454 0.2615 -3.139272 -3.234255 -0.147273 0.959763 1.055608 c -2.387145 1.002667 -2.97355 3.817474 -1.911383 5.858174 z"/>
              </Canvas>
          </Viewbox>
      </DataTemplate>
      <DataTemplate x:Key="MoveNodesIcon">
          <Viewbox Stretch="Uniform">
              <Canvas Width="48" Height="48">
                  <Path Fill="White" StrokeThickness="1.125" Stroke="{StaticResource PrimaryBrush}" Data="m 33.5625 14.959821 -2.53125 4.0625 c 4.266346 2.635565 5.573065 8.171154 2.9375 12.4375 -2.635565 4.266346 -8.171154 5.573065 -12.4375 2.9375 -0.486396 -0.300474 -0.927402 -0.647575 -1.34375 -1.03125 l 1.6875 -0.96875 -8.25 -4.84375 -0.09375 9.59375 2.34375 -1.34375 c 0.915764 1.043001 1.972441 1.956194 3.15625 2.6875 6.473304 3.998928 15.032322 1.973304 19.03125 -4.5 3.998928 -6.473304 1.973304 -15.032322 -4.5 -19.03125 z M 17.571428 13.5 l 4.714286 0 m -8.142857 0 1.714286 0 M 8.9999998 13.5 12 13.5 m -6.4285712 -5.9285717 20.1428562 0 0 11.8571427 -20.1428562 0 z"/>
              </Canvas>
          </Viewbox>
      </DataTemplate>
      <Style TargetType="HeaderedContentControl" x:Key="HeaderedContentStyle">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Template">
              <Setter.Value>
                  <ControlTemplate TargetType="HeaderedContentControl">
                      <Border BorderBrush="{StaticResource PrimaryBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" Margin="0" Padding="0">
                          <Grid>
                              <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto"/>
                                  <RowDefinition/>
                              </Grid.RowDefinitions>
                              <Border Background="{StaticResource HeaderBackgroundBrush}" Padding="10,5">
                                  <ContentControl ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}" KeyboardNavigation.IsTabStop="false" Foreground="{StaticResource HeaderForegroundBrush}"/>
                              </Border>
                              <ContentControl ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.Row="1"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" KeyboardNavigation.IsTabStop="false"/>
                          </Grid>
                      </Border>
                  </ControlTemplate>
              </Setter.Value>
          </Setter>
      </Style>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top">
          <Button Command="IncreaseZoom" CommandTarget="{Binding ElementName=graphControl}"/>
          <Button Command="DecreaseZoom" CommandTarget="{Binding ElementName=graphControl}"/>
          <Button Command="{x:Static ywpf:GraphCommands.FitGraphBounds}" CommandTarget="{Binding ElementName=graphControl}"/>
          <Separator />
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}"/>
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}"/>
          <Separator />
          <Button Command="Cut" CommandTarget="{Binding ElementName=graphControl}"/>
          <Button Command="Copy" CommandTarget="{Binding ElementName=graphControl}"/>
          <Button Command="Paste" CommandTarget="{Binding ElementName=graphControl}"/>
          <Button Command="Delete" CommandTarget="{Binding ElementName=graphControl}"/>
          <Separator />
          <!-- Graph chooser -->
          <Label Content="Graph:" VerticalAlignment="Center"/>
          <Button x:Name="previousButton" Content="&#xE72B;" ToolTip="Previous sample graph" Click="OnPreviousButtonClicked" />
          <ComboBox x:Name="graphChooserBox" Width="250" DisplayMemberPath="DisplayName" SelectionChanged="OnGraphChooserSelectionChanged" ToolTip="Select another sample graph"/>
          <Button x:Name="nextButton" Content="&#xE72A;" ToolTip="Next sample graph" Click="OnNextButtonClicked"/>
          <!-- Graph loading indicator -->
          <Label x:Name="graphLoadingLabel" Visibility="Collapsed" Content="Loading Graph"/>
          <ProgressBar IsIndeterminate="True" Width="120" Height="10" x:Name="graphLoadingBar" Visibility="Collapsed"/>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" HorizontalScrollBarPolicy="Hidden" VerticalScrollBarPolicy="Hidden" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Settings" ExpandedWidth="390" IsExpanded="True">
      <Grid>
        <Grid.Resources>
          <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="MaxLines" Value="1"/>
          </Style>
          <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>
          <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="14,2,0,2"/>
          </Style>
          <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="5"/>
          </Style>
          <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
          </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <HeaderedContentControl Grid.Row="0" Padding="5"  Header="Performance optimizations" Style="{StaticResource HeaderedContentStyle}" BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid.Resources>
              </Grid.Resources>
              <StackPanel>
                <CheckBox Content="Disable overview" IsChecked="{Binding OverviewDisabled}" ToolTip="Disables the overview control, which can make drawing the main graph control slower"/>
                <GroupBox>
                  <GroupBox.Header>
                    <CheckBox x:Name="chkFastStyles" Margin="0" Content="Enable fast styles" IsChecked="{Binding FastStylesEnabled}" ToolTip="Enables level-of-detail styles and low-fidelity styles for low zoom levels"/>
                  </GroupBox.Header>
                  <Grid IsEnabled="{Binding IsChecked, ElementName=chkFastStyles}">
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0">Edges</Label>
                    <Label Grid.Row="1" Grid.Column="0" Margin="20,0,0,0">Hide edges shorter than</Label>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinimumEdgeLength}" ToolTip="Edges shorter than this many pixels are not drawn; this doesn't affect the visual result much" VerticalAlignment="Center"/>
                    <Label Grid.Row="1" Grid.Column="2">px</Label>
                    <Label Grid.Row="2" Grid.Column="0" Margin="20,0,0,0">Don't show bends below</Label>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EdgeBendThreshold}" ToolTip="Bends will not be shown below this zoom level"/>
                    <Label Grid.Row="2" Grid.Column="2">%</Label>
                    <Label Grid.Row="3" Grid.Column="0">Edge labels</Label>
                    <Label Grid.Row="4" Grid.Column="0" Margin="20,0,0,0">Hide below</Label>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EdgeLabelVisibilityThreshold}" ToolTip="Hide edge labels below this zoom level" />
                    <Label Grid.Row="4" Grid.Column="2">%</Label>
                    <Label Grid.Row="5" Grid.Column="0" Margin="20,0,0,0">Sketch below</Label>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EdgeLabelTextThreshold}" ToolTip="Render edge labels as sketch below this zoom level"/>
                    <Label Grid.Row="5" Grid.Column="2">%</Label>
                    <Label Grid.Row="6" Grid.Column="0">Nodes</Label>
                    <Label Grid.Row="7" Grid.Column="0" Margin="20,0,0,0">Prettier node style above</Label>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ComplexNodeStyleThreshold}" ToolTip="Render nodes in a more complex style above this zoom level" />
                    <Label Grid.Row="7" Grid.Column="2">%</Label>
                    <Label Grid.Row="8" Grid.Column="0">Node labels</Label>
                    <Label Grid.Row="9" Grid.Column="0" Margin="20,0,0,0">Hide below</Label>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding NodeLabelVisibilityThreshold}" ToolTip="Hide node labels below this zoom level"/>
                    <Label Grid.Row="9" Grid.Column="2">%</Label>
                    <Label Grid.Row="10" Grid.Column="0" Margin="20,0,0,0">Sketch below</Label>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding NodeLabelTextThreshold}" ToolTip="Render node labels as sketch below this zoom level"/>
                    <Label Grid.Row="10" Grid.Column="2">%</Label>
                  </Grid>
                </GroupBox>
                <GroupBox>
                  <GroupBox.Header>
                    <CheckBox x:Name="chkVirtualization" Margin="0" IsChecked="{Binding VirtualizationDisabled}" ToolTip="Disables virtualization which improves panning performance below the configured zoom levels at the expense of worsening zooming performance when crossing the threshold">Disable virtualization</CheckBox>
                  </GroupBox.Header>
                  <Grid IsEnabled="{Binding IsChecked, ElementName=chkVirtualization}" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0">Don't virtualize edges below</Label>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EdgeVirtualizationThreshold}" ToolTip="Below this zoom level edges will not be virtualized"/>
                    <Label Grid.Row="0" Grid.Column="2">%</Label>
                    <Label Grid.Row="1" Grid.Column="0">Don't virtualize nodes below</Label>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NodeVirtualizationThreshold}" ToolTip="Below this zoom level nodes will not be virtualized" />
                    <Label Grid.Row="1" Grid.Column="2">%</Label>
                  </Grid>
                </GroupBox>
                <CheckBox IsChecked="{Binding SelectionHandlesDisabled}" HorizontalAlignment="Left" ToolTip="Disables selection handles, which can slow down things considerably if there are many of them">Disable selection handles</CheckBox>
                <CheckBox IsChecked="{Binding CustomSelectionDecoratorEnabled}" ToolTip="Uses faster implementations for the selection decoration" Content="Enable custom selection decoration"/>
                <CheckBox IsChecked="{Binding LabelModelBakingEnabled}" ToolTip="Fixes the position of labels on the canvas which makes calculating their position much cheaper">Enable label model baking</CheckBox>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </HeaderedContentControl>
        <HeaderedContentControl Grid.Row="1" Header="Test controls" Padding="5" Style="{StaticResource HeaderedContentStyle}" BorderThickness="0,0,1,0">
          <StackPanel>
            <StackPanel.Resources>
              <local:GradientConverter x:Key="GradientConverter"/>
              <Style TargetType="Ellipse">
                <Setter Property="Width" Value="15"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="Stroke" Value="DarkGray"/>
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Margin" Value="5"/>
              </Style>
            </StackPanel.Resources>
            <GroupBox Header="Information">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" ToolTip="The current zoom level of the graph control">Zoom level</Label>
                <Label Grid.Row="0" Grid.Column="1" Content="{Binding Zoom, ElementName=graphControl}" ContentStringFormat="P1" HorizontalAlignment="Right" ToolTip="The current zoom level of the graph control"/>
                <Label Grid.Row="1" Grid.Column="0" ToolTip="The number of currently selected elements">Selected items</Label>
                <Label Grid.Row="1" Grid.Column="1" Content="{Binding SelectionCount, RelativeSource={RelativeSource AncestorType={x:Type local:LargeGraphsDemo}}}" HorizontalAlignment="Right" ToolTip="The number of currently selected elements" />
                <Label Grid.Row="2" Grid.Column="0" ToolTip="The number of elements in the WPF visual tree">Elements in visual tree</Label>
                <Label Grid.Row="2" Grid.Column="1" Content="{Binding VisualChildren, RelativeSource={RelativeSource AncestorType={x:Type local:LargeGraphsDemo}}}" HorizontalAlignment="Right" ToolTip="The number of elements in the WPF visual tree"/>
                <Ellipse Grid.Row="2" Grid.Column="2" Fill="{Binding VisualChildren, RelativeSource={RelativeSource AncestorType={x:Type local:LargeGraphsDemo}}, Converter={StaticResource GradientConverter}, ConverterParameter=10000}" ToolTip="Indicates the badness of the number of visual tree elements. More than a few thousand can cause slowness."/>
                <Label Grid.Row="3" Grid.Column="0" ToolTip="The current number of frames drawn per second">Frames per second</Label>
                <Label Grid.Row="3" Grid.Column="1" Content="{Binding Fps, RelativeSource={RelativeSource AncestorType={x:Type local:LargeGraphsDemo}}}" HorizontalAlignment="Right" ContentStringFormat="0.0" ToolTip="The current number of frames drawn per second"/>
                <Ellipse Grid.Row="3" Grid.Column="2" Fill="{Binding Fps, RelativeSource={RelativeSource AncestorType={x:Type local:LargeGraphsDemo}}, Converter={StaticResource GradientConverter}, ConverterParameter=-60}" ToolTip="Indicates the badness of the current frames per second. Values below 30 can appear jerky."/>
              </Grid>
            </GroupBox>
            <GroupBox x:Name="grpAnimations" Header="Animations">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Click="OnZoomAnimationClicked" Grid.Column="0" ToolTip="Zooms to a random node and back">
                  <StackPanel>
                    <ContentPresenter ContentTemplate="{StaticResource ZoomIcon}" Width="40"/>
                    <Label Padding="0" HorizontalContentAlignment="Center">Zoom</Label>
                  </StackPanel>
                </Button>
                <Button Click="OnPanAnimationClicked" Grid.Column="1" ToolTip="Pans the viewport in a circular motion">
                  <StackPanel>
                    <ContentPresenter ContentTemplate="{StaticResource RotateIcon}" Width="40"/>
                    <Label Padding="0" HorizontalContentAlignment="Center">Pan in circle</Label>
                  </StackPanel>
                </Button>
                <Button Click="OnSpiralZoomAnimationClicked" Grid.Column="2" ToolTip="Combines zooming and panning at the same time">
                  <StackPanel>
                    <ContentPresenter ContentTemplate="{StaticResource SpiralZoomIcon}" Width="40"/>
                    <Label Padding="0" HorizontalContentAlignment="Center">Spiral zoom</Label>
                  </StackPanel>
                </Button>
                <Button Click="OnNodeAnimationClicked" Grid.Column="3" ToolTip="Moves selected nodes randomly">
                  <StackPanel>
                    <ContentPresenter ContentTemplate="{StaticResource MoveNodesIcon}" Width="40"/>
                    <Label Padding="0" HorizontalContentAlignment="Center" Content="Move nodes"/>
                  </StackPanel>
                </Button>
              </Grid>
            </GroupBox>
            <GroupBox Header="Selection">
              <Grid>
                <Grid.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                  </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1">Nodes</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2">Edges</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="3">Labels</TextBlock>
                <Button Content="Nothing" Grid.Row="1" Grid.Column="0" Click="OnSelectNothingClicked" ToolTip="Deselect everything"/>
                <Button Content="1000" Grid.Row="1" Grid.Column="1" Click="OnSelect1000NodesClicked" ToolTip="Select 1000 random nodes"/>
                <Button Content="1000" Grid.Row="1" Grid.Column="2" Click="OnSelect1000EdgesClicked" ToolTip="Select 1000 random edges"/>
                <Button Content="1000" Grid.Row="1" Grid.Column="3" Click="OnSelect1000LabelsClicked" ToolTip="Select 1000 random labels"/>
                <Button Content="Everything" Grid.Row="2" Grid.Column="0" Click="OnSelectEverythingClicked" ToolTip="Select all nodes, edges and labels in the graph"/>
                <Button Content="All" Grid.Row="2" Grid.Column="1" Click="OnSelectAllNodesClicked" ToolTip="Select all nodes"/>
                <Button Content="All" Grid.Row="2" Grid.Column="2" Click="OnSelectAllEdgesClicked" ToolTip="Select all edges"/>
                <Button Content="All" Grid.Row="2" Grid.Column="3" Click="OnSelectAllLabelsClicked" ToolTip="Select all labels"/>
              </Grid>
            </GroupBox>
          </StackPanel>
        </HeaderedContentControl>
      </Grid>
    </demo:SideBar>
    <demo:Description Source="description.html" />
    <demo:FloatingButton Header="Overview" IsExpanded="{Binding OverviewDisabled, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}">
      <ywpf:GraphOverviewControl x:Name="OverviewControl" GraphControl="{Binding ElementName=graphControl}" />
    </demo:FloatingButton>
  </demo:DemoView>
</demo:Demo>
