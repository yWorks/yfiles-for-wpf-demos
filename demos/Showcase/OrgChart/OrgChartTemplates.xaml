                <Setter Property="Source" Value="{StaticResource usericon_female5}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- data template for an employee node at the detail zoom level -->
    <!-- An image is displayed together with text for the name, position, email, phone and fax attributes. -->
    <!-- Additionally, there is a little graphic for displaying the color-coded status of an employee. -->
    <DataTemplate x:Key="DetailNodeStyleTemplate">
        <Grid>
            <Grid.ToolTip>
                <ContentPresenter ContentTemplate="{StaticResource AllPropertiesTemplate}" />
            </Grid.ToolTip>
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,*,Auto,Auto" Margin="0 15 10 0">
                <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                    Style="{StaticResource EmployeeUserIconStyle}"
                    Width="63.75" Height="63.75" HorizontalAlignment="Center" VerticalAlignment="Top">
                </Image>
                <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Width="15" Height="15" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource present}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding XPath=@status}" Value="travel">
                                        <Setter Property="Source" Value="{StaticResource travel}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding XPath=@status}" Value="unavailable">
                                        <Setter Property="Source" Value="{StaticResource unavailable}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="{Binding XPath=@status}" VerticalAlignment="Center" Margin="5 0 0 5"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding XPath=@name}" FontSize="16" Foreground="#369"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding XPath=@position}" TextWrapping="Wrap" MaxWidth="185"/>
                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding XPath=@email}"/>
                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                    <TextBlock Text="{Binding XPath=@phone}" Margin="0 0 0 5"/>
                    <TextBlock Text="{Binding XPath=@fax}" Margin="15 0 0 5"/>
                </StackPanel>
            </Grid>
            <Rectangle Fill="{Binding XPath=@status, Converter={StaticResource StatusToColorConverter}}" Height="10" VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>

    <!-- data template for an employee node at the intermediate zoom level. -->
    <!-- Just the name and a color-coded status indicator graphic are displayed. -->
    <DataTemplate x:Key="IntermediateNodeStyleTemplate">
        <Grid>
            <Grid.ToolTip>
                <ContentPresenter ContentTemplate="{StaticResource MainPropertiesTemplate}" />
            </Grid.ToolTip>
            <Grid ColumnDefinitions="75,*" RowDefinitions="Auto,*" Margin="0,15,0,0">
                <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                       Style="{StaticResource EmployeeUserIconStyle}"
                       Width="56.25" Height="56.25" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding XPath=@name}" FontSize="22" FontWeight="SemiBold" Foreground="#369" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding XPath=@position}" TextWrapping="Wrap" MaxWidth="210"/>
            </Grid>
            <Rectangle Fill="{Binding XPath=@status, Converter={StaticResource StatusToColorConverter}}" Height="5" VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>

    <!-- data template for an employee node at the overview zoom level. -->
    <!-- Just the abbreviated name and a color-coded status indicator graphic are displayed. -->
    <DataTemplate x:Key="OverviewNodeStyleTemplate">
        <Grid x:Name="Panel">
            <Grid.ToolTip>
                <ContentPresenter ContentTemplate="{StaticResource MainPropertiesTemplate}" />
            </Grid.ToolTip>
            <Rectangle Fill="{Binding XPath=@status, Converter={StaticResource StatusToColorConverter}}" />
            <TextBlock Foreground="White" FontSize="40" Text="{Binding XPath=@name, Converter={StaticResource NameToShortNameConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
        </Grid>
    </DataTemplate>


    <local:ZoomToTemplateConverter x:Key="ZoomConverter" 
        DetailThreshold="0.7"
        OverviewThreshold="0.4"
        DetailTemplate="{StaticResource DetailNodeStyleTemplate}" 
        OverviewTemplate="{StaticResource OverviewNodeStyleTemplate}"
        NormalTemplate="{StaticResource IntermediateNodeStyleTemplate}" />

    <!-- The main node style template switches the visual appearance of the employee nodes with -->
    <!-- respect to the focused state by delegating to one of the templates defined above. -->
    <Style x:Key="EmployeeNodeControlStyle" TargetType="ywpf:NodeControl">
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ywpf:NodeControl">
                    <Border x:Name="border">
                        <Grid>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <SolidColorBrush x:Name="ShadowColor" Color="#99666666"></SolidColorBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="5" Y="5"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Fill="White" />
                            <!-- Contents of the node using one of the data templates above, default OverviewNodeStyleTemplate -->
                            <ContentPresenter x:Name="Presenter" ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent},Path=CanvasControl.Zoom, Converter={StaticResource ZoomConverter}}"/>
                            <StackPanel x:Name="Buttons" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Collapsed">
                                <Button x:Name="ShowParentButton" ToolTip="Show Parent"
                                        Visibility="{Binding ElementName=ShowParentButton, Path=IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                        CommandParameter="{TemplateBinding Item}"
                                        Command="local:OrgChartDemo.ShowParentCommand">
                                    <demo:PathIcon Width="16" Height="16" Geometry="{StaticResource IconKeyboardArrowUp}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </Button>
                                <Button x:Name="HideParentButton" ToolTip="Hide Parent"
                                        Visibility="{Binding ElementName=HideParentButton, Path=IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="local:OrgChartDemo.HideParentCommand"
                                        CommandParameter="{TemplateBinding Item}">
                                    <demo:PathIcon Width="16" Height="16" Geometry="{StaticResource IconKeyboardArrowDown}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ShowChildrenButton" ToolTip="Show Children"
                                            Visibility="{Binding ElementName=ShowChildrenButton, Path=IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="local:OrgChartDemo.ShowChildrenCommand"
                                            CommandParameter="{TemplateBinding Item}">
                                        <demo:PathIcon Width="16" Height="16" Geometry="{StaticResource IconAdd}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="HideChildrenButton" ToolTip="Hide Children"
                                            Visibility="{Binding ElementName=HideChildrenButton, Path=IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="local:OrgChartDemo.HideChildrenCommand"
                                            CommandParameter="{TemplateBinding Item}">
                                        <demo:PathIcon Width="16" Height="16" Geometry="{StaticResource IconRemove}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Rectangle StrokeThickness="1">
                                <Rectangle.Stroke>
                                    <SolidColorBrush x:Name="BackgroundColor" Color="#C0C0C0"></SolidColorBrush>
                                </Rectangle.Stroke>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Buttons"  Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ItemFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard >
                                    <BeginStoryboard.Storyboard>
                                        <Storyboard>
                                            <ColorAnimation Duration="0:0:0.15" Storyboard.TargetName="BackgroundColor" Storyboard.TargetProperty="Color" To="Orange"/>
                                            <ColorAnimation Duration="0:0:0.15" Storyboard.TargetName="ShadowColor" Storyboard.TargetProperty="Color" To="#99c68a49"/>
                                        </Storyboard>
                                    </BeginStoryboard.Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard >
                                    <BeginStoryboard.Storyboard>
                                        <Storyboard>
                                            <ColorAnimation Duration="0:0:0.3" Storyboard.TargetName="BackgroundColor" Storyboard.TargetProperty="Color"/>
                                            <ColorAnimation Duration="0:0:0.3" Storyboard.TargetName="ShadowColor" Storyboard.TargetProperty="Color"/>
                                        </Storyboard>
                                    </BeginStoryboard.Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>