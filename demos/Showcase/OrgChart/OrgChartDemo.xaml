<demo:Demo x:Class="yWorks.Demo.OrgChart.OrgChartDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
    xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
    xmlns:local="clr-namespace:yWorks.Demo.OrgChart">
  <demo:Demo.Resources>
    <ResourceDictionary>
      <!-- Merge in the templates used for displaying the entities in our chart -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OrgChartTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <local:NodeToEmployeeConverter x:Key="NodeConverter" />
      <!-- The GraphSource creates the organization chart graph from the employee business data. -->
      <ywpf:TreeSource x:Key="TreeSource" GraphRebuilt="TreeSource_GraphRebuilt">
        <ywpf:TreeSource.ChildBinding>
          <Binding XPath="employee"/>
        </ywpf:TreeSource.ChildBinding>
        <ywpf:TreeSource.NodeControlStyle>
          <Binding Source="{StaticResource EmployeeNodeControlStyle}"/>
        </ywpf:TreeSource.NodeControlStyle>
        <ywpf:TreeSource.EdgeStyle>
          <ywpf:PolylineEdgeStyle SmoothingLength="10" TargetArrow="{ywpf:Arrow Type=Stealth}"/>
        </ywpf:TreeSource.EdgeStyle>
      </ywpf:TreeSource>
    </ResourceDictionary>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button ToolTip="Zoom to Selected Employee"
                      Content="{StaticResource IconAsterisk}"
                      Command="{x:Static ywpf:GraphCommands.ZoomToCurrentItem}"
                      CommandTarget="{Binding ElementName=graphControl}"/>
          <Separator/>
          <Button ToolTipService.ToolTip="Shows the Complete Chart"
                      Content="Show All"  
                      Command="local:OrgChartDemo.ShowAllCommand"
                      CommandTarget="{Binding ElementName=graphControl}"/>
          <Button ToolTipService.ToolTip="Show Parent" Margin="2,0,2,0"
                      Content="{StaticResource IconKeyboardArrowUp}" 
                      Command="local:OrgChartDemo.ShowParentCommand"
                      CommandParameter="{Binding ElementName=graphControl, Path=CurrentItem}"
                      CommandTarget="{Binding ElementName=graphControl}"/>
          <Button ToolTipService.ToolTip="Hide Parent" Margin="2,0,2,0"
                      Content="{StaticResource IconKeyboardArrowDown}" 
                      Command="local:OrgChartDemo.HideParentCommand"
                      CommandParameter="{Binding ElementName=graphControl, Path=CurrentItem}"
                      CommandTarget="{Binding ElementName=graphControl}"/>
          <Button ToolTipService.ToolTip="Show Children" Margin="2,0,2,0"
                      Content="{StaticResource IconAdd}" 
                      Command="local:OrgChartDemo.ShowChildrenCommand"
                      CommandParameter="{Binding ElementName=graphControl, Path=CurrentItem}"
                      CommandTarget="{Binding ElementName=graphControl}"/>
          <Button ToolTipService.ToolTip="Hide Children" Margin="2,0,2,0"
                      Content="{StaticResource IconRemove}" 
                      Command="local:OrgChartDemo.HideChildrenCommand"
                      CommandParameter="{Binding ElementName=graphControl, Path=CurrentItem}"
                      CommandTarget="{Binding ElementName=graphControl}"/>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl"
              HorizontalScrollBarPolicy="Hidden" VerticalScrollBarPolicy="Hidden">
          <ywpf:GraphControl.InputMode>
            <ywpf:GraphViewerInputMode
                      ClickableItems="Node"
                      ItemDoubleClicked="OnItemDoubleClicked"
                      SelectableItems="None"
                      MarqueeSelectableItems="None"
                      ToolTipItems="None"
                      ContextMenuItems="None"
                      FocusableItems="Node"/>
          </ywpf:GraphControl.InputMode>
          <ywpf:GraphControl.CommandBindings>
            <CommandBinding Command="{x:Static local:OrgChartDemo.ShowChildrenCommand}" CanExecute="CanExecuteShowChildren" Executed="ShowChildrenExecuted"/>
            <CommandBinding Command="{x:Static local:OrgChartDemo.ShowParentCommand}" CanExecute="CanExecuteShowParent" Executed="ShowParentExecuted"/>
            <CommandBinding Command="{x:Static local:OrgChartDemo.HideChildrenCommand}" CanExecute="CanExecuteHideChildren" Executed="HideChildrenExecuted"/>
            <CommandBinding Command="{x:Static local:OrgChartDemo.HideParentCommand}" CanExecute="CanExecuteHideParent" Executed="HideParentExecuted"/>
          </ywpf:GraphControl.CommandBindings>
          <ywpf:GraphControl.InputBindings>
            <KeyBinding Key="Add" Command="IncreaseZoom" CommandParameter="2.0"/>
            <KeyBinding Key="Subtract" Command="DecreaseZoom" CommandParameter="2.0"/>
            <KeyBinding Key="OemPlus" Command="IncreaseZoom" CommandParameter="2.0"/>
            <KeyBinding Key="OemMinus" Command="DecreaseZoom" CommandParameter="2.0"/>
            <KeyBinding Key="Enter" Command="ywpf:GraphCommands.ZoomToCurrentItem"/>
            <KeyBinding Key="Left" Modifiers="Control"  Command="ScrollPageLeft" CommandParameter="0.20"/>
            <KeyBinding Key="Right" Modifiers="Control" Command="ScrollPageRight" CommandParameter="0.20"/>
            <KeyBinding Key="Up" Modifiers="Control"   Command="ScrollPageUp" CommandParameter="0.20"/>
            <KeyBinding Key="Down" Modifiers="Control"  Command="ScrollPageDown" CommandParameter="0.20"/>
            <KeyBinding Key="PageUp" Modifiers="Control"  Command="local:OrgChartDemo.ShowParentCommand"/>
            <KeyBinding Key="PageDown" Modifiers="Control" Command="local:OrgChartDemo.HideParentCommand"/>
            <KeyBinding Key="Add" Modifiers="Control"   Command="local:OrgChartDemo.ShowChildrenCommand"/>
            <KeyBinding Key="Subtract" Modifiers="Control"  Command="local:OrgChartDemo.HideChildrenCommand"/>
          </ywpf:GraphControl.InputBindings>
        </ywpf:GraphControl>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Employee Details" IsExpanded="False">
      <StackPanel>
        <ContentControl
                    Content="{Binding ElementName=graphControl, Path=CurrentItem, Converter={StaticResource NodeConverter}}"
                    ContentTemplate="{Binding Source={StaticResource AllPropertiesTemplate}}">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger
                                    Binding="{Binding ElementName=graphControl, Path=CurrentItem}"
                                    Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
        <TextBlock Text="Select an employee in the organization chart to show their properties."
                           HorizontalAlignment="Stretch" TextWrapping="Wrap"
                           Padding="2 0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger
                                    Binding="{Binding ElementName=graphControl, Path=CurrentItem}"
                                    Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
