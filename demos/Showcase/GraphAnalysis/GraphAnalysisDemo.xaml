<demo:Demo x:Class="yWorks.Demo.GraphAnalysis.GraphAnalysisDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" x:Name="toolbar" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Content="New" ToolTip="Clear graph" Click="OnNew" />
          <Separator />
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Button Content="Layout" Click="OnLayout" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Graph Settings">
      <StackPanel x:Name="settingsPanel">
        <TextBlock Text="Sample:" Margin="0,4" />
        <ComboBox ItemsSource="{Binding Algorithms}" DisplayMemberPath="Name" SelectedItem="{Binding Sample}" />
        <TextBlock Text="Algorithm:" Margin="0,8,0,4" />
        <ComboBox ItemsSource="{Binding Algorithms}" DisplayMemberPath="Name" SelectedItem="{Binding Algorithm}" />
        <TextBlock Text="Algorithm Settings" FontWeight="Bold" Margin="0,10,0,4" />
        <ComboBox SelectedIndex="{Binding WeightIndex}" IsEnabled="{Binding SupportsWeights}">
          <ComboBoxItem Content="Uniform Edge Weights" />
          <ComboBoxItem Content="Non-uniform Edge Weights" />
        </ComboBox>
        <ComboBox SelectedIndex="{Binding DirectionIndex}" IsEnabled="{Binding SupportsDirection}" Margin="0,4,0,0">
          <ComboBoxItem Content="Undirected" />
          <ComboBoxItem Content="Directed" />
        </ComboBox>
        <TextBlock Text="Graph Structure" FontWeight="Bold" FontSize="16" Margin="0,16,0,6" />
        <TextBlock Text="Observe how the results change when the graph is modified." TextWrapping="Wrap" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Number of Nodes" FontWeight="Bold" Padding="0,3" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NodeCount}" FontWeight="Bold" TextAlignment="Right" Padding="0,3" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Number of Edges" FontWeight="Bold" Padding="0,3" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EdgeCount}" FontWeight="Bold" TextAlignment="Right" Padding="0,3" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Structures}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,1">
                <TextBlock DockPanel.Dock="Right"><Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnStructureLink">?</Hyperlink></TextBlock>
                <TextBlock Text="{Binding Name}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Opacity" Value="0.55" />
                      <Style.Triggers><DataTrigger Binding="{Binding Matches}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Algorithm Description" FontWeight="Bold" FontSize="16" Margin="0,16,0,6" />
        <ItemsControl ItemsSource="{Binding DescriptionParagraphs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
