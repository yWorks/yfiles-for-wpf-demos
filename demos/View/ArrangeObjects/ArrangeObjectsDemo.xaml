<demo:Demo x:Class="yWorks.Demo.ArrangeObjects.ArrangeObjectsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="{x:Static input:ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="{x:Static input:ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Label Content="Align vertically:" VerticalAlignment="Center" Margin="5 0 0 0" />
          <Button x:Name="alignTopButton" Content="{StaticResource IconVerticalAlignTop}" ToolTip="Align Top" />
          <Button x:Name="alignVerticallyButton" Content="{StaticResource IconAlignVerticalCenter}" ToolTip="Align Vertically" />
          <Button x:Name="alignBottomButton" Content="{StaticResource IconVerticalAlignBottom}" ToolTip="Align Bottom" />
          <Separator />
          <Label Content="Align horizontally:" VerticalAlignment="Center" Margin="5 0 0 0" />
          <Button x:Name="alignLeftButton" Content="{StaticResource IconHorizontalAlignLeft}" ToolTip="Align Left" />
          <Button x:Name="alignHorizontallyButton" Content="{StaticResource IconAlignHorizontalCenter}" ToolTip="Align Horizontally" />
          <Button x:Name="alignRightButton" Content="{StaticResource IconHorizontalAlignRight}" ToolTip="Align Right" />
          <Separator />
          <Label Content="Distribute:" VerticalAlignment="Center" Margin="5 0 0 0" />
          <Button x:Name="distributeVerticallyButton" Content="{StaticResource IconVerticalDistribute}" ToolTip="Distribute Vertically" />
          <Button x:Name="distributeHorizontallyButton" Content="{StaticResource IconHorizontalDistribute}" ToolTip="Distribute Horizontally" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
