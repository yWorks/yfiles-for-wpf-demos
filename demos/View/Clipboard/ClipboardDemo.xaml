<demo:Demo x:Class="yWorks.Demo.Clipboard.ClipboardDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <demo:DemoView Grid.Column="0" Margin="2">
      <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
        <DockPanel>
          <demo:DemoToolBar DockPanel.Dock="Top">
            <Button Command="DecreaseZoom" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Zoom Out" />
            <Button Command="IncreaseZoom" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Zoom In" />
            <Button Command="{x:Static ywpf:GraphCommands.FitGraphBounds}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Fit Graph" />
            <Separator />
            <Button Command="{x:Static input:ApplicationCommands.Cut}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Cut" />
            <Button Command="{x:Static input:ApplicationCommands.Copy}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Copy" />
            <Button Command="{x:Static input:ApplicationCommands.Paste}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Paste" />
            <Button Command="{x:Static input:ApplicationCommands.Delete}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Delete" />
            <Button x:Name="pasteSpecialButton" Content="Paste Special" IsEnabled="False" Click="OnPasteSpecial" />
            <Separator />
            <Button Command="{x:Static input:ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Undo" />
            <Button Command="{x:Static input:ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=graphControl}" ToolTip="Redo" />
            <Separator />
            <Button x:Name="editNameButton" Content="Edit Name" IsEnabled="False" Click="OnEditName" />
          </demo:DemoToolBar>
          <Grid>
            <Border BorderBrush="#FFFFFF" BorderThickness="3" CornerRadius="6">
              <ywpf:GraphControl x:Name="graphControl" Background="White" />
            </Border>
            <Popup x:Name="nameDialog" Placement="Center" PlacementTarget="{Binding ElementName=graphControl}"
                 StaysOpen="True" AllowsTransparency="True">
              <Border Width="340" Padding="18" Background="White" CornerRadius="8"
                    BorderBrush="#777777" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Node Name" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <TextBlock Text="Edit the node name" Margin="0,0,0,4" />
                  <TextBox x:Name="nodeNameInput" MaxLength="25" Margin="0,0,0,12" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancelName" />
                    <Button Content="Apply" Width="80" IsDefault="True" Click="OnApplyName" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </DockPanel>
      </demo:ClippingBorder>
    </demo:DemoView>
    <Border Grid.Column="1" Width="1" Margin="0,48,0,20" Background="#9AAAB3"
            IsHitTestVisible="False" />
    <demo:DemoView Grid.Column="2" Margin="2">
      <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
        <DockPanel>
          <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl2}">
            <Button Command="{x:Static input:ApplicationCommands.Cut}" CommandTarget="{Binding ElementName=graphControl2}" ToolTip="Cut" />
            <Button Command="{x:Static input:ApplicationCommands.Copy}" CommandTarget="{Binding ElementName=graphControl2}" ToolTip="Copy" />
            <Button Command="{x:Static input:ApplicationCommands.Paste}" CommandTarget="{Binding ElementName=graphControl2}" ToolTip="Paste" />
            <Button Command="{x:Static input:ApplicationCommands.Delete}" CommandTarget="{Binding ElementName=graphControl2}" ToolTip="Delete" />
            <Button x:Name="pasteSpecialButton2" Content="Paste Special" IsEnabled="False" Click="OnPasteSpecial2" />
            <Separator />
            <Button Command="{x:Static input:ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=graphControl2}" ToolTip="Undo" />
            <Button Command="{x:Static input:ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=graphControl2}" ToolTip="Redo" />
            <Separator />
            <Button x:Name="editNameButton2" Content="Edit Name" IsEnabled="False" Click="OnEditName2" />
          </demo:DemoToolBar>
          <Grid>
            <Border BorderBrush="#FFFFFF" BorderThickness="3" CornerRadius="6">
              <ywpf:GraphControl x:Name="graphControl2" Background="White" />
            </Border>
            <Popup x:Name="nameDialog2" Placement="Center" PlacementTarget="{Binding ElementName=graphControl2}"
                 StaysOpen="True" AllowsTransparency="True">
              <Border Width="340" Padding="18" Background="White" CornerRadius="8"
                    BorderBrush="#777777" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Node Name" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <TextBlock Text="Edit the node name" Margin="0,0,0,4" />
                  <TextBox x:Name="nodeNameInput2" MaxLength="25" Margin="0,0,0,12" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancelName2" />
                    <Button Content="Apply" Width="80" IsDefault="True" Click="OnApplyName2" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </DockPanel>
      </demo:ClippingBorder>
    </demo:DemoView>
    <demo:Description Grid.Column="3" Source="description.html" />
  </Grid>
</demo:Demo>
