<demo:Demo x:Class="yWorks.Demo.SimpleGraphML.SimpleGraphMLDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           FocusManager.FocusedElement="{Binding ElementName=graphControl}">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom, File" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Button Command="Cut" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Copy" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Paste" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <ToggleButton x:Name="IncludeGraphSettingsButton" IsChecked="False">
              <TextBlock Text="Include Graph Settings" />
          </ToggleButton>
        </demo:DemoToolBar>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ywpf:GraphControl x:Name="graphControl" Grid.Row="0" Background="White">
            <ywpf:GraphControl.InputMode>
              <ywpf:GraphEditorInputMode />
            </ywpf:GraphControl.InputMode>
          </ywpf:GraphControl>
          <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
          <DockPanel Grid.Row="2">
            <ToolBarTray DockPanel.Dock="Top">
              <ToolBar ToolBarTray.IsLocked="True">
                <Button Click="ShowGraphMLButton_Click" ToolTip="Show GraphML" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Content="&#xE74B;" />
                <Button Click="ApplyGraphMLButton_Click" ToolTip="Apply GraphML" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Content="&#xE74A;"/>
                <Separator />
                <Button Command="Undo" CommandTarget="{Binding ElementName=graphMLText}" />
                <Button Command="Redo" CommandTarget="{Binding ElementName=graphMLText}" />
              </ToolBar>
            </ToolBarTray>
            <TextBox x:Name="graphMLText" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" />
          </DockPanel>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
