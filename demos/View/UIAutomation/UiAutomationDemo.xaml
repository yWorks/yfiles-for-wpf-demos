<demo:Demo x:Class="yWorks.Demo.UIAutomation.UIAutomationDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.UIAutomation"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           FocusManager.FocusedElement="{Binding ElementName=graphControl}">
  <demo:Demo.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UIAutomation;component/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="2" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="Margin" Value="2" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="2" />
      </Style>
    </ResourceDictionary>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="{x:Static ywpf:GraphCommands.GroupSelection}" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="{x:Static ywpf:GraphCommands.UngroupSelection}" CommandTarget="{Binding ElementName=graphControl}" />
        </demo:DemoToolBar>
        <Grid>
          <local:AutomationGraphControl x:Name="graphControl"
                                      Background="White"
                                      AutomationProperties.AutomationId="DemoGraphControl"
                                      ViewportChanged="OnGraphControlViewportChanged" />
          <Canvas x:Name="overlayContainer"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Rectangle x:Name="overlay" Fill="#7EFF0000" Stroke="Blue" StrokeThickness="3" />
          </Canvas>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="UI Automation" ExpandedWidth="460" IsExpanded="True" ClipToBounds="True">
      <ScrollViewer x:Name="sidebarScrollViewer"
                    Margin="0,0,16,0"
                    ClipToBounds="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="{Binding ViewportWidth, ElementName=sidebarScrollViewer}"
                    HorizontalAlignment="Left">
          <GroupBox Header="UI Automation tree">
            <DockPanel>
              <Button DockPanel.Dock="Top" Click="OnRefreshTreeClicked">Refresh tree</Button>
              <TreeView x:Name="uiaTree" BorderThickness="0" SelectedItemChanged="OnSelectedItemChanged">
                <TreeView.Template>
                  <ControlTemplate>
                    <ItemsPresenter />
                  </ControlTemplate>
                </TreeView.Template>
              </TreeView>
            </DockPanel>
          </GroupBox>
          <GroupBox Header="Patterns">
            <StackPanel>
              <GroupBox Header="Selection">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnRefreshSelectionClicked">Refresh</Button>
                    <StackPanel VerticalAlignment="Center">
                      <Label Margin="0,0,5,0">Current selection:</Label>
                      <Label x:Name="lbCurrentSelection">
                        <Label.ContentTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </Label.ContentTemplate>
                      </Label>
                    </StackPanel>
                  </DockPanel>
                  <StackPanel x:Name="pnlSelectionItem">
                    <Button x:Name="btSelect" Click="OnSelectClicked">Select</Button>
                    <Button x:Name="btAddToSelection" Click="OnAddToSelectionClicked">
                      <TextBlock Text="Add to selection" TextWrapping="Wrap" />
                    </Button>
                    <Button x:Name="btRemoveFromSelection" Click="OnRemoveFromSelectionClicked">
                      <TextBlock Text="Remove from selection" TextWrapping="Wrap" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="grpToggle" Header="Toggle">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Label Margin="0,0,5,0">Current value:</Label>
                    <Label x:Name="lbCurrentToggleValue" />
                  </StackPanel>
                  <Button Click="OnToggleClicked">Toggle</Button>
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="grpExpandCollapse" Header="Expand / Collapse">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Label Margin="0,0,5,0">Current value:</Label>
                    <Label x:Name="lbCurrentExpandValue" />
                  </StackPanel>
                  <StackPanel>
                    <Button Click="OnCollapseClicked">Collapse</Button>
                    <Button Click="OnExpandClicked">Expand</Button>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="grpInvoke" Header="Invoke">
                <Button Click="OnInvokeClicked">Invoke</Button>
              </GroupBox>
              <GroupBox x:Name="grpValue" Header="Value">
                <DockPanel>
                  <Button x:Name="btnSetValue" DockPanel.Dock="Right" Click="OnSetValueClicked">Set</Button>
                  <TextBox x:Name="tbCurrentValue" Margin="2" />
                </DockPanel>
              </GroupBox>
              <GroupBox x:Name="grpScrollItem" Header="ScrollItem">
                <Button Click="OnScrollIntoViewClicked">
                  <TextBlock Text="Scroll into view" TextWrapping="Wrap" />
                </Button>
              </GroupBox>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Simulated Interaction" x:Name="selectionItem">
            <StackPanel>
              <RichTextBox BorderThickness="0" IsReadOnly="True" x:Name="rtbInteractionHint">
                <FlowDocument>
                  <Paragraph>
                    To enable simulated interaction, add either
                    <Run FontFamily="Consolas, Courier New">Microsoft.TestApi</Run> or
                    <Run FontFamily="Consolas, Courier New">TestStack.White</Run> to the project and define the
                    <Run FontFamily="Consolas, Courier New">TestApi</Run> or
                    <Run FontFamily="Consolas, Courier New">White</Run> compilation symbol.
                  </Paragraph>
                </FlowDocument>
              </RichTextBox>
              <GroupBox Header="Draw edge" x:Name="grpDrawEdge">
                <Grid Margin="2">
                  <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right">Source node:</Label>
                  <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right">Target node:</Label>
                  <ComboBox x:Name="fromNode" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Item1" SelectedValuePath="Item2" />
                  <ComboBox x:Name="toNode" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Item1" SelectedValuePath="Item2" />
                  <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="drawEdgeButton" Click="OnDrawEdgeClicked">Draw edge</Button>
                </Grid>
              </GroupBox>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
