<demo:Demo x:Class="yWorks.Demo.Collapse.CollapseDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:collapse="clr-namespace:yWorks.Demo.Collapse">
  <demo:Demo.Resources>
    <Style x:Key="CollapsibleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="InnerBorder" CornerRadius="4" Background="#01baff" />
              <Path x:Name="IconPath" Stretch="None" Fill="#999999" Stroke="White" Height="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="16"
                    Data="M5.5,0.5 L10.5,0.5 L10.5,5.5 L15.5,5.5 L15.5,10.5 L10.5,10.5 L10.5,15.5 L5.5,15.5 L5.5,10.5 L0.5,10.5 L0.5,5.5 L5.5,5.5 z" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="InnerBorder" Property="Background" Value="#f26419" />
                <Setter TargetName="IconPath" Property="Data"
                        Value="M5.5,0.5 L10.5,0.5 L10.5,5.5 L15.5,5.5 L15.5,10.5 L10.5,10.5 L10.5,15.5 L5.5,15.5 L5.5,10.5 L0.5,10.5 L0.5,5.5 L5.5,5.5 z" />
              </Trigger>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="InnerBorder" Property="Background" Value="#01baff" />
                <Setter TargetName="IconPath" Property="Data"
                        Value="M10.5,5.5 L15.5,5.5 L15.5,10.5 L10.5,10.5 L5.5,10.5 L0.5,10.5 L0.5,5.5 L5.5,5.5 z" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InnerNodeStyleTemplate" TargetType="ywpf:NodeControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ywpf:NodeControl">
            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Style="{StaticResource CollapsibleButtonStyle}"
                          IsChecked="{Binding Path=StyleTag, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                          Command="{x:Static collapse:CollapseDemo.ToggleChildrenCommand}"
                          CommandParameter="{TemplateBinding Item}"
                          CommandTarget="{Binding ElementName=graphControl}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LeafNodeStyleTemplate" TargetType="ywpf:NodeControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ywpf:NodeControl">
            <Border CornerRadius="4" Background="#76b041" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </demo:Demo.Resources>
  <demo:DemoView>
    <!-- The demo's graph view. -->
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label Content="Layout:" />
          <ComboBox x:Name="layoutComboBox" ToolTip="Choose a layout algorithm" SelectedIndex="0" Width="130">
            <ComboBoxItem Content="Tree" Tag="tree" />
            <ComboBoxItem Content="Radial Tree" Tag="radial-tree" />
            <ComboBoxItem Content="Organic" Tag="organic" />
            <ComboBoxItem Content="Hierarchical" Tag="hierarchical" />
          </ComboBox>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White">
          <ywpf:GraphControl.CommandBindings>
            <CommandBinding Command="{x:Static collapse:CollapseDemo.ToggleChildrenCommand}"
                          Executed="ToggleChildrenExecuted" />
          </ywpf:GraphControl.CommandBindings>
        </ywpf:GraphControl>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
