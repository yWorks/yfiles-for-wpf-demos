<demo:Demo x:Class="yWorks.Demo.Bridges.BridgesDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar x:Name="settingsPanel" Header="Settings">
      <StackPanel>
        <Label Content="Crossing Style" Padding="0,4" />
        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CrossingStyle}">
          <ComboBoxItem Content="Arc" Tag="{x:Static ywpf:BridgeCrossingStyle.Arc}" />
          <ComboBoxItem Content="Gap" Tag="{x:Static ywpf:BridgeCrossingStyle.Gap}" />
          <ComboBoxItem Content="TwoSidesScaled" Tag="{x:Static ywpf:BridgeCrossingStyle.TwoSidesScaled}" />
          <ComboBoxItem Content="TwoSides" Tag="{x:Static ywpf:BridgeCrossingStyle.TwoSides}" />
          <ComboBoxItem Content="Custom" Tag="{x:Static ywpf:BridgeCrossingStyle.Custom}" />
          <ComboBoxItem Content="Rectangle" Tag="{x:Static ywpf:BridgeCrossingStyle.Rectangle}" />
          <ComboBoxItem Content="RectangleScaled" Tag="{x:Static ywpf:BridgeCrossingStyle.RectangleScaled}" />
          <ComboBoxItem Content="ArcScaled" Tag="{x:Static ywpf:BridgeCrossingStyle.ArcScaled}" />
        </ComboBox>
        <Label Content="Crossing Policy" Padding="0,4" />
        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CrossingPolicy}">
          <ComboBoxItem Content="HorizontalBridgesVertical" Tag="{x:Static ywpf:BridgeCrossingPolicy.HorizontalBridgesVertical}" />
          <ComboBoxItem Content="VerticalBridgesHorizontal" Tag="{x:Static ywpf:BridgeCrossingPolicy.VerticalBridgesHorizontal}" />
          <ComboBoxItem Content="MoreHorizontalBridgesLessHorizontal" Tag="{x:Static ywpf:BridgeCrossingPolicy.MoreHorizontalBridgesLessHorizontal}" />
          <ComboBoxItem Content="MoreVerticalBridgesLessVertical" Tag="{x:Static ywpf:BridgeCrossingPolicy.MoreVerticalBridgesLessVertical}" />
        </ComboBox>
        <Label Content="Bridge Orientation" Padding="0,4" />
        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding OrientationStyle}">
          <ComboBoxItem Content="Up" Tag="{x:Static ywpf:BridgeOrientationStyle.Up}" />
          <ComboBoxItem Content="Down" Tag="{x:Static ywpf:BridgeOrientationStyle.Down}" />
          <ComboBoxItem Content="Left" Tag="{x:Static ywpf:BridgeOrientationStyle.Left}" />
          <ComboBoxItem Content="Right" Tag="{x:Static ywpf:BridgeOrientationStyle.Right}" />
          <ComboBoxItem Content="FlowRight" Tag="{x:Static ywpf:BridgeOrientationStyle.FlowRight}" />
          <ComboBoxItem Content="Positive" Tag="{x:Static ywpf:BridgeOrientationStyle.Positive}" />
          <ComboBoxItem Content="Negative" Tag="{x:Static ywpf:BridgeOrientationStyle.Negative}" />
          <ComboBoxItem Content="FlowLeft" Tag="{x:Static ywpf:BridgeOrientationStyle.FlowLeft}" />
        </ComboBox>
        <Label Content="Width" Padding="0,4" />
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Width="32" Margin="4,0,0,0"
                     Text="{Binding BridgeWidth, StringFormat={}{0:0}}" />
          <Slider Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding BridgeWidth}" />
        </DockPanel>
        <Label Content="Height" Padding="0,4" />
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Width="32" Margin="4,0,0,0"
                     Text="{Binding BridgeHeight, StringFormat={}{0:0}}" />
          <Slider Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding BridgeHeight}" />
        </DockPanel>
        <Label Content="Max Width" Padding="0,4" />
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Width="32" Margin="4,0,0,0"
                     Text="{Binding MaximumBridgeWidth, StringFormat={}{0:0}}" />
          <Slider Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding MaximumBridgeWidth}" />
        </DockPanel>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
