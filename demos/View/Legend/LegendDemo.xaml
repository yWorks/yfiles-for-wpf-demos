<demo:Demo x:Class="yWorks.Demo.Legend.LegendDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <ComboBox x:Name="legendTypeComboBox" Width="145" SelectedIndex="0" SelectionChanged="OnLegendTypeChanged"
                  ToolTip="Select the type of legend">
            <ComboBoxItem Content="Overlay Panel" Tag="overlay" />
            <ComboBoxItem Content="Render Tree" Tag="world" />
            <ComboBoxItem Content="Render Tree (fixed-size)" Tag="view" />
            <ComboBoxItem Content="Graph Control" Tag="graphControl" />
          </ComboBox>
          <CheckBox x:Name="legendVisibilityToggle" Content="Show legend" IsChecked="True"
                  Checked="OnLegendVisibilityChanged" Unchecked="OnLegendVisibilityChanged" />
          <CheckBox x:Name="orientationToggle" Content="Horizontal" ToolTip="Display the legend horizontally at the bottom or vertically at the right"
                  Checked="OnOrientationChanged" Unchecked="OnOrientationChanged" />
          <CheckBox x:Name="viewportFilterToggle" Content="Only types in viewport" ToolTip="Show only node types visible in the viewport"
                  Checked="OnViewportFilterChanged" Unchecked="OnViewportFilterChanged" />
        </demo:DemoToolBar>
        <Grid>
          <ywpf:GraphControl x:Name="graphControl" />
          <Border x:Name="overlayLegendContainer" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,70,16,16" Padding="14" MinWidth="180" MinHeight="104" MaxHeight="680"
                Background="#F238536B" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Legend" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="600">
                <StackPanel x:Name="overlayLegendEntries" Orientation="Vertical" />
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border x:Name="graphLegendContainer" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" Width="300" Height="340" MaxWidth="900" MaxHeight="680"
                Background="#F238536B" CornerRadius="8" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Button x:Name="graphLegendHeader" Grid.Row="0" Content="Legend" Click="OnToggleGraphLegend" />
              <ywpf:GraphControl x:Name="legendGraphControl" Grid.Row="1" Background="Transparent" />
            </Grid>
          </Border>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
