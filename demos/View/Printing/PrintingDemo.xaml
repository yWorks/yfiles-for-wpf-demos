<demo:Demo x:Class="yWorks.Demo.Printing.PrintingDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:option="http://www.yworks.com/yfilesWPF/3.0/demos/optionhandler">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Print" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="PrintPreview" CommandTarget="{Binding ElementName=graphControl}">
            <StackPanel Orientation="Horizontal">
              <demo:PathIcon Width="16" Height="16" Geometry="{StaticResource IconPrint}" Margin="0 0 4 0"/>
              <TextBlock>Print Preview</TextBlock>
            </StackPanel>
          </Button>
          <Button Click="pageSetupButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Text="&#xE713;" Margin="0 0 4 0"/>
              <TextBlock>Page Setup</TextBlock>
            </StackPanel>
          </Button>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl">
          <ywpf:GraphControl.CommandBindings>
            <CommandBinding Command="PrintPreview" Executed="printPreviewButton_Click" />
            <CommandBinding Command="Print" Executed="printerSetupButton_Click" />
          </ywpf:GraphControl.CommandBindings>
        </ywpf:GraphControl>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Printing Options" ExpandedWidth="250" IsExpanded="True">
      <option:EditorControl x:Name="editorControl" IsAutoAdopt="True" IsAutoCommit="True" />
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
