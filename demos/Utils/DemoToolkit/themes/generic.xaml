<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:demo="clr-namespace:yWorks.Demo"
                    xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DemoToolkit;component/Resources/yFilesDemoStyles.xaml"/>
        <ResourceDictionary Source="/DemoToolkit;component/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ToolBarIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <Style x:Key="ToolBarIconToggleButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SideBarHeaderButtonStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                    x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12,12,0,0"
                    Padding="12,5,5,5"
                    >
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"
                                />
                            <Border
                                x:Name="IconBorder"
                                Background="{DynamicResource SubtleFillColorTransparentBrush}"
                                Grid.Column="1"
                                CornerRadius="4"
                                >
                                <TextBlock
                                    x:Name="Icon"
                                    Margin="5"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="&#xE76C;"
                                    />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Icon" Property="Text" Value="&#xE70D;"/>
                            <Setter TargetName="IconBorder" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="ContentPresenter" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="8,0,0,0"/>
                            <Setter TargetName="Border" Property="CornerRadius" Value="12"/>
                            <Setter TargetName="Border" Property="Padding" Value="5,5,12,5"/>
                        </Trigger>
                        <Trigger SourceName="IconBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="demo:SideBar">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="ExpandedWidth" Value="320"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type demo:SideBar}">
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        CornerRadius="12"
                        Width="{TemplateBinding ActualWidth}"
                        >
                        <DockPanel HorizontalAlignment="Stretch">
                            <ToggleButton 
                                 x:Name="CollapseButton"
                                 Style="{StaticResource SideBarHeaderButtonStyle}"
                                 DockPanel.Dock="Top"
                                 IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsExpanded, Mode=TwoWay}"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch"
                                 Content="{TemplateBinding Header}"
                                 />
                            <ContentPresenter
                                 x:Name="ContentPresenter"
                                 Visibility="Collapsed"
                                 Margin="{TemplateBinding Padding}"
                                 Content="{TemplateBinding Content}"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                 />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="CollapseButton" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Border" Property="Width" Value="Auto" />
                        </Trigger>
                        <Trigger Property="IsCollapsible" Value="False">
                            <Setter Property="IsEnabled" TargetName="CollapseButton" Value="False"/>
                            <Setter Property="Visibility" TargetName="ContentPresenter" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsExpanded" Value="False">
                <Setter Property="Padding" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="demo:Description" BasedOn="{StaticResource {x:Type demo:SideBar}}">
        <Setter Property="Header" Value="Description"/>
    </Style>

    <demo:HalfHeightToCornerRadiusConverter x:Key="HeightCornerRadiusConverter"/>

    <Style x:Key="FloatingButtonCollapsedButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CircleElevationBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        CornerRadius="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ActualHeight, Converter={StaticResource HeightCornerRadiusConverter}}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        >
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FloatingButtonExpandedButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SideBarHeaderButtonStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>

    <DataTemplate x:Key="FloatingButtonIconHeaderTemplate">
        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Text="{Binding}"/>
    </DataTemplate>

    <demo:FloatingButtonHeaderTemplateSelector x:Key="FloatingButtonHeaderTemplateSelector" IconTemplate="{StaticResource FloatingButtonIconHeaderTemplate}"/>

    <Style TargetType="demo:FloatingButton" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
        <Setter Property="CollapsedHeader">
            <Setter.Value>
                <demo:PathIcon Geometry="{StaticResource IconMap}" Width="16" Height="16"/>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplateSelector" Value="{StaticResource FloatingButtonHeaderTemplateSelector}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="demo:FloatingButton">
                    <DockPanel>
                        <ToggleButton x:Name="CollapsedHeader"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding CollapsedHeader}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                      DockPanel.Dock="Top"
                                      Style="{StaticResource FloatingButtonCollapsedButtonStyle}"
                                      Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                        <ToggleButton x:Name="ExpandedHeader"
                                      Visibility="Collapsed"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                      DockPanel.Dock="Top"
                                      Style="{StaticResource FloatingButtonExpandedButtonStyle}"
                                      Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                        <demo:ClippingBorder
                            x:Name="ExpandSite"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </demo:ClippingBorder>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter Property="Visibility" TargetName="ExpandSite" Value="Visible"/>
                            <Setter Property="Visibility" TargetName="CollapsedHeader" Value="Collapsed"/>
                            <Setter Property="Visibility" TargetName="ExpandedHeader" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsExpanded" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolBarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <!-- Default tooltip for buttons with a command: Easier to remove with a trigger if there is no command -->
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Command.Text}"/>

        <Style.Triggers>
            <Trigger Property="Command" Value="{x:Null}">
                <Setter Property="ToolTip" Value="{x:Null}"/>
            </Trigger>

            <!-- Command icons -->

            <Trigger Property="Command" Value="DecreaseZoom">
                <Setter Property="Content" Value="&#xE71F;"/>
            </Trigger>
            <Trigger Property="Command" Value="IncreaseZoom">
                <Setter Property="Content" Value="&#xE8A3;"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.FitContent}">
                <Setter Property="Content" Value="&#xE9A6;"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.FitGraphBounds}">
                <Setter Property="Content" Value="&#xE9A6;"/>
            </Trigger>
            <Trigger Property="Command" Value="Cut">
                <Setter Property="Content" Value="&#xE8C6;"/>
            </Trigger>
            <Trigger Property="Command" Value="Copy">
                <Setter Property="Content" Value="&#xE8C8;"/>
            </Trigger>
            <Trigger Property="Command" Value="Paste">
                <Setter Property="Content" Value="&#xE77F;"/>
            </Trigger>
            <Trigger Property="Command" Value="Save">
                <Setter Property="Content" Value="&#xE74E;"/>
            </Trigger>
            <Trigger Property="Command" Value="SaveAs">
                <Setter Property="Content" Value="&#xE792;"/>
            </Trigger>
            <Trigger Property="Command" Value="Open">
                <Setter Property="Content" Value="&#xED25;"/>
            </Trigger>
            <Trigger Property="Command" Value="Delete">
                <Setter Property="Content" Value="&#xE74D;"/>
            </Trigger>
            <Trigger Property="Command" Value="Print">
                <Setter Property="Content" Value="&#xE749;"/>
            </Trigger>
            <Trigger Property="Command" Value="Undo">
                <Setter Property="Content" Value="&#xE7A7;"/>
            </Trigger>
            <Trigger Property="Command" Value="Redo">
                <Setter Property="Content" Value="&#xE7A6;"/>
            </Trigger>
            <Trigger Property="Command" Value="New">
                <Setter Property="Content" Value="&#xE7C3;"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.GroupSelection}">
                <Setter Property="Content" Value="{StaticResource IconGroup}"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.UngroupSelection}">
                <Setter Property="Content" Value="{StaticResource IconUngroup}"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.EnterGroup}">
                <Setter Property="Content" Value="{StaticResource IconEnterGroup}"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.ExitGroup}">
                <Setter Property="Content" Value="{StaticResource IconExitGroup}"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.Raise}">
                <Setter Property="Content" Value="&#xE74A;"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.Lower}">
                <Setter Property="Content" Value="&#xE74B;"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.ToFront}">
                <Setter Property="Content" Value="&#xE898;"/>
            </Trigger>
            <Trigger Property="Command" Value="{x:Static ywpf:GraphCommands.ToBack}">
                <Setter Property="Content" Value="&#xE896;"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolBarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplateSelector" Value="{StaticResource ButtonTemplateSelector}"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        >
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <!--<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />-->
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="demo:DemoToolBar">
        <Style.Resources>
            <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource ToolBarButtonStyle}"/>
            <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource ToolBarToggleButtonStyle}"/>
            <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource SubtleComboBoxStyle}"/>
            <Style TargetType="Label">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0" />
            </Style>
        </Style.Resources>

        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="demo:DemoToolBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid x:Name="OverflowGrid" DockPanel.Dock="Right">
                                <ToggleButton ClickMode="Press" Content="&#xE712;" Style="{StaticResource ToolBarIconToggleButton}" IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsOverflowOpen}"/>
                                <Popup AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" IsOpen="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsOverflowOpen}" StaysOpen="False">
                                    <Border Margin="20" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Color="Black" Direction="270" Opacity="0.24"/>
                                        </Border.Effect>
                                        <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" KeyboardNavigation.DirectionalNavigation="Cycle" FocusVisualStyle="{x:Null}" Focusable="true" Margin="2" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle" WrapWidth="10"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowItems" Value="False">
                            <Setter TargetName="OverflowGrid" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="demo:DemoView">
        <Setter Property="Gap" Value="8"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <Style TargetType="demo:DragAndDropListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="demo:DragAndDropListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Chrome-less button used for breadcrumb links -->
    <Style x:Key="BreadcrumbButtonStyle" TargetType="ButtonBase">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Breadcrumbs -->
    <Style TargetType="{x:Type demo:Breadcrumbs}">
        <Setter Property="FontSize" Value="28"/>

        <!-- Let items receive focus; container itself doesn’t need to be a Tab stop -->
        <Setter Property="Focusable" Value="False"/>
        <!-- Tab into the control once, then Tab out -->
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="AlternationCount" Value="2147483647"/>

        <!-- Horizontal StackPanel + native Left/Right navigation -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabNavigation="Continue"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <!-- Default chevron separator -->
        <Setter Property="SeparatorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="&#xE974;"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               FontSize="12"
                               Margin="{Binding SeparatorMargin, RelativeSource={RelativeSource AncestorType={x:Type demo:Breadcrumbs}}}"
                               VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- Render all breadcrumbs without adapting to available space. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type demo:Breadcrumbs}">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BreadcrumbItem -->
    <Style TargetType="{x:Type demo:BreadcrumbItem}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type demo:BreadcrumbItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <!-- Separator before every item except the first. -->
                        <ContentPresenter x:Name="PART_Separator"
                                          Grid.Column="0"
                                          Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type demo:Breadcrumbs}}}"
                                          ContentTemplate="{Binding SeparatorTemplate, RelativeSource={RelativeSource AncestorType={x:Type demo:Breadcrumbs}}}"
                                          VerticalAlignment="Stretch"/>

                        <!-- Clickable version (Button) -->
                        <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Style="{StaticResource BreadcrumbButtonStyle}"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}"
                                CommandTarget="{TemplateBinding CommandTarget}">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Non-clickable version -->
                        <ContentPresenter x:Name="PART_Content"
                                          Grid.Column="1"
                                          ContentSource="Content"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="PART_Separator" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Non-clickable last item (default) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLast, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                <Condition Binding="{Binding IsLastItemClickable, RelativeSource={RelativeSource AncestorType={x:Type demo:Breadcrumbs}}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Button" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Content" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
