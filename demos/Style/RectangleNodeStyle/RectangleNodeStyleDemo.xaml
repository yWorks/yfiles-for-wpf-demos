<demo:Demo x:Class="yWorks.Demo.RectangleNodeStyle.RectangleNodeStyleDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.RectangleNodeStyle">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Style Properties">
      <StackPanel>
        <TextBlock x:Name="InfoMessage"
                   Text="Please select a node to modify its settings."
                   TextWrapping="Wrap" />
        <StackPanel x:Name="StylePropertiesPanel" Visibility="Collapsed">
          <Label Content="Corner Style" Padding="0,4" />
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CornerStyle}"
                    IsEnabled="{Binding IsEnabled}">
            <ComboBoxItem Content="Round" Tag="{x:Static ywpf:CornerStyle.Round}" />
            <ComboBoxItem Content="Cut" Tag="{x:Static ywpf:CornerStyle.Cut}" />
            <ComboBoxItem Content="Squircle" Tag="{x:Static ywpf:CornerStyle.Squircle}" />
          </ComboBox>
          <Label Content="Corner Size Scaling" Padding="0,4" />
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CornerSizeScaling}"
                    IsEnabled="{Binding IsEnabled}">
            <ComboBoxItem Content="Absolute" Tag="{x:Static local:CornerSizeScaling.Absolute}" />
            <ComboBoxItem Content="Relative" Tag="{x:Static local:CornerSizeScaling.Relative}" />
          </ComboBox>
          <TextBlock Text="Affected Corners" FontWeight="SemiBold" Margin="0,10,0,4" />
          <CheckBox Content="Top-left" IsChecked="{Binding TopLeftCornerAffected}"
                    IsEnabled="{Binding IsEnabled}" Margin="0,2" />
          <CheckBox Content="Top-right" IsChecked="{Binding TopRightCornerAffected}"
                    IsEnabled="{Binding IsEnabled}" Margin="0,2" />
          <CheckBox Content="Bottom-left" IsChecked="{Binding BottomLeftCornerAffected}"
                    IsEnabled="{Binding IsEnabled}" Margin="0,2" />
          <CheckBox Content="Bottom-right" IsChecked="{Binding BottomRightCornerAffected}"
                    IsEnabled="{Binding IsEnabled}" Margin="0,2" />
        </StackPanel>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
