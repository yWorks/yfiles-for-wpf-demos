<demo:Demo x:Class="yWorks.Demo.InvariantLabelStyle.InvariantLabelStyleDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <ComboBox x:Name="modeChooserBox" Width="250" ToolTip="Select a style for the labels" />
          <StackPanel x:Name="zoomThresholdControls" Orientation="Horizontal" ToolTip="Select the zoom threshold">
            <Separator />
            <Label Content="Zoom Threshold:" Margin="10,0,4,0" VerticalAlignment="Center" />
            <Slider x:Name="zoomThresholdSlider" Minimum="1" Maximum="4" Value="1" TickFrequency="0.1"
                  Width="120" VerticalAlignment="Center" />
            <Label x:Name="zoomThresholdLabel" Width="36" VerticalAlignment="Center"
                     Content="{Binding ElementName=zoomThresholdSlider, Path=Value, StringFormat={}{0:0.0}}" />
          </StackPanel>
          <StackPanel x:Name="maxScaleControls" Orientation="Horizontal" Visibility="Collapsed"
                    ToolTip="Select the maximum level where zoom is applied">
            <Separator />
            <Label Content="Max Scale:" Margin="10,0,4,0" VerticalAlignment="Center" />
            <Slider x:Name="maxScaleSlider" Minimum="1" Maximum="4" Value="3" TickFrequency="0.1"
                  Width="120" VerticalAlignment="Center" />
            <Label x:Name="maxScaleLabel" Width="36" VerticalAlignment="Center"
                     Content="{Binding ElementName=maxScaleSlider, Path=Value, StringFormat={}{0:0.0}}" />
          </StackPanel>
          <Separator />
          <Label Content="Current Zoom Level:" Margin="6,0,4,0" VerticalAlignment="Center" />
          <Label x:Name="zoomLevel" Content="1.00" Width="42" VerticalAlignment="Center" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
