<demo:Demo x:Class="yWorks.Demo.SelectionStyling.SelectionStylingDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label Content="Custom Selection Decoration:" VerticalAlignment="Center" Margin="4,0" />
          <CheckBox x:Name="NodeDecorationToggle" Content="Nodes" IsChecked="True" Margin="4,0" />
          <CheckBox x:Name="EdgeDecorationToggle" Content="Edges" IsChecked="True" Margin="4,0" />
          <CheckBox x:Name="LabelDecorationToggle" Content="Labels" IsChecked="True" Margin="4,0" />
          <Separator />
          <Label Content="Zoom Mode:" VerticalAlignment="Center" Margin="4,0" />
          <ComboBox x:Name="ZoomModeComboBox" SelectedValuePath="Tag"
                  SelectedValue="{x:Static ywpf:StyleIndicatorZoomPolicy.Mixed}"
                  MinWidth="150" ToolTip="Select the zoom mode">
            <ComboBoxItem Content="Mixed" Tag="{x:Static ywpf:StyleIndicatorZoomPolicy.Mixed}" />
            <ComboBoxItem Content="Zoom with Graph" Tag="{x:Static ywpf:StyleIndicatorZoomPolicy.WorldCoordinates}" />
            <ComboBoxItem Content="Always the Same Size" Tag="{x:Static ywpf:StyleIndicatorZoomPolicy.ViewCoordinates}" />
            <ComboBoxItem Content="No Downscaling" Tag="{x:Static ywpf:StyleIndicatorZoomPolicy.NoDownscaling}" />
          </ComboBox>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
