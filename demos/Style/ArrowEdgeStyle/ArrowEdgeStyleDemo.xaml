<demo:Demo x:Class="yWorks.Demo.ArrowEdgeStyle.ArrowEdgeStyleDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.ArrowEdgeStyle">
  <demo:Demo.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>

    <demo:SideBar Header="Style Properties">
      <StackPanel x:Name="StylePropertiesPanel">
        <TextBlock Text="Please select an edge to modify its settings."
                   TextWrapping="Wrap"
                   Visibility="{Binding IsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Label Content="Basic Shape" Padding="0,4" />
          <ComboBox x:Name="ShapeComboBox" SelectedItem="{Binding Shape}" IsEnabled="{Binding IsEnabled}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding }" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Label Content="Thickness" Padding="0,4" />
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Width="28" Margin="4,0,0,0"
                       Text="{Binding Thickness, StringFormat={}{0:0}}" />
            <Slider Minimum="1" Maximum="100" IsEnabled="{Binding IsEnabled}"
                    Value="{Binding Thickness}" />
          </DockPanel>
          <Label Content="Angle" Padding="0,4" />
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Width="28" Margin="4,0,0,0"
                       Text="{Binding Angle, StringFormat={}{0:0}}" />
            <Slider Minimum="{Binding AngleMinimum}" Maximum="90" IsEnabled="{Binding IsEnabled}"
                    Value="{Binding Angle}" />
          </DockPanel>
          <Label Content="Shaft Ratio" Padding="0,4" />
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Width="28" Margin="4,0,0,0"
                       Text="{Binding ShaftRatio, StringFormat={}{0:0.0}}" />
            <Slider Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsShaftRatioEnabled}" Value="{Binding ShaftRatio}" />
          </DockPanel>
          <Label Content="Cropping" Padding="0,4" />
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Width="28" Margin="4,0,0,0"
                       Text="{Binding Cropping, StringFormat={}{0:0.0}}" />
            <Slider Minimum="0" Maximum="20" TickFrequency="0.1" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding IsEnabled}" Value="{Binding Cropping}" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
