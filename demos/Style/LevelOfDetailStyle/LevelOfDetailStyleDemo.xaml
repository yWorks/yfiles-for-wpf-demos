<demo:Demo x:Class="yWorks.Demo.LevelOfDetailStyle.LevelOfDetailStyleDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:Demo.Resources>
    <Style x:Key="DetailLevelNodeControlStyle" TargetType="ywpf:NodeControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ywpf:NodeControl">
            <Canvas Width="285" Height="100">
              <Rectangle Canvas.Left="2" Canvas.Top="2" Width="285" Height="100" Fill="#C0C0C0" />
              <Rectangle Width="285" Height="100" Fill="White" Stroke="#C0C0C0" StrokeThickness="1" />
              <Rectangle Width="3" Height="100" Fill="Black" />
              <Rectangle Canvas.Left="282" Width="3" Height="100" Fill="Black" />
              <Rectangle Width="285" Height="3" Fill="Black" />
              <Rectangle Canvas.Top="97" Width="285" Height="3" Fill="Black" />
              <TextBlock Canvas.Left="10" Canvas.Top="8" Width="265" Height="22"
                         Text="{Binding Content.Name, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="16" FontWeight="Light" Foreground="#336699"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Canvas.Left="10" Canvas.Top="32" Width="265" Height="16"
                         Text="{Binding Content.DisplayPosition, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="10" Foreground="#444444"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Canvas.Left="10" Canvas.Top="60" Width="265" Height="14"
                         Text="{Binding Content.Email, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="10" FontWeight="Light" Foreground="#444444"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Canvas.Left="10" Canvas.Top="76" Width="265" Height="14"
                         Text="{Binding Content.Phone, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="10" FontWeight="Light" Foreground="#444444"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Canvas>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IntermediateLevelNodeControlStyle" TargetType="ywpf:NodeControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ywpf:NodeControl">
            <Canvas Width="285" Height="100">
              <Rectangle Canvas.Left="2" Canvas.Top="2" Width="285" Height="100" Fill="#C0C0C0" />
              <Rectangle Width="285" Height="100" Fill="White" Stroke="#C0C0C0" StrokeThickness="1" />
              <Rectangle Width="3" Height="100" Fill="Black" />
              <Rectangle Canvas.Left="282" Width="3" Height="100" Fill="Black" />
              <Rectangle Width="285" Height="3" Fill="Black" />
              <Rectangle Canvas.Top="97" Width="285" Height="3" Fill="Black" />
              <TextBlock Canvas.Left="10" Canvas.Top="8" Width="265" Height="36"
                         Text="{Binding Content.Name, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="26" Foreground="#336699"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Canvas.Left="10" Canvas.Top="50" Width="265" Height="20"
                         Text="{Binding Content.DisplayPosition, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="15" Foreground="#444444"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Canvas>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OverviewLevelNodeControlStyle" TargetType="ywpf:NodeControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ywpf:NodeControl">
            <Canvas Width="285" Height="100">
              <Rectangle Canvas.Left="-1" Canvas.Top="-1" Width="288" Height="103" Fill="#AAAAAA" />
              <Rectangle Width="285" Height="100" Fill="White" />
              <Rectangle Width="3" Height="100" Fill="Black" />
              <Rectangle Canvas.Left="282" Width="3" Height="100" Fill="Black" />
              <Rectangle Width="285" Height="3" Fill="Black" />
              <Rectangle Canvas.Top="97" Width="285" Height="3" Fill="Black" />
              <TextBlock Canvas.Left="10" Canvas.Top="26" Width="265" Height="48"
                         Text="{Binding Content.Name, RelativeSource={RelativeSource TemplatedParent}}"
                         FontFamily="Roboto" FontSize="40" Foreground="#336699"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Canvas>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <Grid>
          <ywpf:GraphControl x:Name="graphControl" Background="White"
                           SizeChanged="GraphControlSizeChanged" />
          <Border x:Name="detailLevelPopup" Height="100" VerticalAlignment="Bottom"
                Background="#80FFFFFF" IsHitTestVisible="False" Opacity="0">
            <TextBlock x:Name="detailLevelPopupText" Foreground="#646464"
                     FontSize="40" TextAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
