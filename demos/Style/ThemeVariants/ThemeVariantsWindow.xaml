<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
        x:Class="Demo.yFiles.Graph.ThemeVariants.ThemeVariantsWindow"
        Title="Theme Variants Demo"
        Style="{StaticResource DemoWindow}"
        Loaded="OnLoaded">
    <HeaderedContentControl Style="{StaticResource DemoStyle}">
        <HeaderedContentControl.Header>
            <RichTextBox IsReadOnly="True" BorderThickness="0">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="This demo shows various interaction visualization themes simultaneously."/>
                    </Paragraph>
                    <Paragraph>
                        <Run Text="Each graph component uses a different "/>
                        <Run Style="{StaticResource HtmlCode}" Text="ThemeVariant"/>
                        <Run Text=", written in the top left corner of the graph component."/>
                    </Paragraph>
                    <Paragraph Style="{StaticResource HtmlH2}">
                        <Run Text="Things to try:"/>
                    </Paragraph>
                    <List>
                        <ListItem>
                            <Paragraph>
                                <Run Text="Navigate/edit one graph component to see the changes mirrored in the other components."/>
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                <Run Text="While a node is selected, drag the sliders to observe the changes. See how the scale also affects the handle and indicator offset."/>
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                <Run Text="Choose a different color palette to use as the theme colors. Note that hatched brushes only work with SolidColorBrushes, not e.g. with a gradient."/>
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                <Run Text="Select, highlight and focus graph elements using the toolbar buttons to see how theming affects the indicators."/>
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                <Run Text="Drag labels in the individual graph components to see how label candidates are affected by theming."/>
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                <Run Text="Other items affected by theming are:"/>
                            </Paragraph>
                            <List>
                                <ListItem>
                                    <Paragraph>
                                        <Run Text="Bends"></Run>
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Run Text="Port Candidates"></Run>
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Run Text="Port Selection"></Run>
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Run Text="Marquee Selection"></Run>
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Run Text="Overview Rectangle"></Run>
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Run Text="Stripe selection, resize, drag source and drop target"></Run>
                                    </Paragraph>
                                </ListItem>
                            </List>
                        </ListItem>
                    </List>
                </FlowDocument>
            </RichTextBox>
        </HeaderedContentControl.Header>
        <DockPanel>
            <ToolBarTray Height="Auto" Width="Auto" DockPanel.Dock="Top">
                <ToolBar
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ToolBarTray}, Mode=FindAncestor}}"
                    Height="Auto" x:Name="ToolBar">
                    <Button x:Name="IncreaseZoomButton" Command="IncreaseZoom" />
                    <Button x:Name="DecreaseZoomButton" Command="DecreaseZoom" />
                    <Button x:Name="FitBoundsButton" Command="{x:Static input:GraphCommands.FitGraphBounds}" />
                    <Label Content="Scale: "/>
                    <Slider Margin="0,5" x:Name="ScaleSlider" Minimum="0.5" Maximum="4" IsSnapToTickEnabled="True"
                            TickFrequency="0.1" Orientation="Horizontal" Width="100" ValueChanged="OnScaleChanged" />
                    <TextBlock
                        Text="{Binding Value, ElementName=ScaleSlider, StringFormat=0.0, UpdateSourceTrigger=PropertyChanged}"
                        Margin="5" />
                    <Separator />
                    <Label Content="Handle Offset: "/>
                    <Slider Margin="0,5" x:Name="HandleOffsetSlider" Minimum="-1" Maximum="5" IsSnapToTickEnabled="True"
                            TickFrequency="0.5" Orientation="Horizontal" Width="100" ValueChanged="OnHandleOffsetChanged" />
                    <TextBlock
                        Text="{Binding Value, ElementName=HandleOffsetSlider, StringFormat=0.0, UpdateSourceTrigger=PropertyChanged}"
                        Margin="5" />
                    <Separator />
                    <Label Content="Indicator Offset: "/>
                    <Slider Margin="0,5" x:Name="IndicatorOffsetSlider" Minimum="-1" Maximum="5" IsSnapToTickEnabled="True"
                            TickFrequency="0.5" Orientation="Horizontal" Width="100" ValueChanged="OnIndicatorOffsetChanged" />
                    <TextBlock
                        Text="{Binding Value, ElementName=IndicatorOffsetSlider, StringFormat=0.0, UpdateSourceTrigger=PropertyChanged}"
                        Margin="5" />
                    <Separator />
                    <Button Margin="2, 0" Click="OnSelectAllClicked">Select All</Button>
                    <ToggleButton x:Name="HighlightAllButton" Margin="2, 0" Click="OnHighlightAllClicked">Highlight All</ToggleButton>
                    <Button Margin="2, 0" Click="OnFocusNodeClicked">Focus Node</Button>
                    <Button Margin="2, 0" Click="OnFocusLabelClicked">Focus Label</Button>
                    <Button Margin="2, 0" Click="OnFocusEdgeClicked">Focus Edge</Button>
                    <Button Margin="2, 0" Click="OnClearFocusClicked">Clear Focus</Button>
                    <Separator />
                </ToolBar>
            </ToolBarTray>
            <UniformGrid x:Name="GraphControlsGrid" Rows="2" Columns="2" Background="#ebeef0" />
        </DockPanel>
    </HeaderedContentControl>
</Window>