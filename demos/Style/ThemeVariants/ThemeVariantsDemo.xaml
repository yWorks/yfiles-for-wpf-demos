<demo:Demo x:Class="yWorks.Demo.ThemeVariants.ThemeVariantsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Scale:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider x:Name="scaleSlider" ToolTip="Theme Scale" Minimum="0.5" Maximum="4" Value="1"
                  TickFrequency="0.1" Width="100" />
            <Label x:Name="scaleLabel" Content="1" Width="30" HorizontalContentAlignment="Right" VerticalAlignment="Center" />
          </StackPanel>
          <Separator />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Handle Offset:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider x:Name="handleOffsetSlider" ToolTip="Handle Offset" Minimum="-1" Maximum="5" Value="2"
                  TickFrequency="0.5" Width="100" />
            <Label x:Name="handleOffsetLabel" Content="2" Width="30" HorizontalContentAlignment="Right" VerticalAlignment="Center" />
          </StackPanel>
          <Separator />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Indicator Offset:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider x:Name="indicatorOffsetSlider" ToolTip="Indicator Offset" Minimum="-1" Maximum="5" Value="2"
                  TickFrequency="0.5" Width="100" />
            <Label x:Name="indicatorOffsetLabel" Content="2" Width="30" HorizontalContentAlignment="Right" VerticalAlignment="Center" />
          </StackPanel>
          <Separator />
          <Button x:Name="blueButton" Content="Blue" Tag="Blue" ToolTip="Blue Color Palette" Click="OnColorPaletteButtonClick" />
          <Button x:Name="orangeButton" Content="Orange" Tag="Orange" ToolTip="Orange Color Palette" Click="OnColorPaletteButtonClick" />
          <Button x:Name="greenButton" Content="Green" Tag="Green" ToolTip="Green Color Palette" Click="OnColorPaletteButtonClick" />
          <Button x:Name="purpleButton" Content="Purple" Tag="Purple" ToolTip="Purple Color Palette" Click="OnColorPaletteButtonClick" />
          <Button x:Name="yellowButton" Content="Yellow" Tag="Yellow" ToolTip="Yellow Color Palette" Click="OnColorPaletteButtonClick" />
        </demo:DemoToolBar>
        <Grid x:Name="graphComponents" Background="#EBEEF0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ywpf:GraphControl x:Name="graphControl" Grid.Row="0" Grid.Column="0" Background="White" />
          <ywpf:GraphControl x:Name="roundHatchedGraphControl" Grid.Row="0" Grid.Column="2" Background="White" />
          <ywpf:GraphControl x:Name="squareGraphControl" Grid.Row="2" Grid.Column="0" Background="White" />
          <ywpf:GraphControl x:Name="squareHatchedGraphControl" Grid.Row="2" Grid.Column="2" Background="White" />
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
