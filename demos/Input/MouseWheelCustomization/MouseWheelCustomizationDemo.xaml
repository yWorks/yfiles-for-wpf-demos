<demo:Demo x:Class="yWorks.Demo.MouseWheelCustomization.MouseWheelCustomizationDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.MouseWheelCustomization">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Settings">
      <StackPanel x:Name="SettingsPanel" Margin="8">
        <Label Content="Wheel Behavior" Padding="0,4" />
        <ComboBox SelectedValue="{Binding WheelBehavior, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag">
          <ComboBoxItem Content="None" Tag="{x:Static local:WheelBehavior.None}" />
          <ComboBoxItem Content="Zoom" Tag="{x:Static local:WheelBehavior.Zoom}" />
          <ComboBoxItem Content="Scroll" Tag="{x:Static local:WheelBehavior.Scroll}" />
          <ComboBoxItem Content="Scroll &amp; Zoom" Tag="{x:Static local:WheelBehavior.Both}" />
          <ComboBoxItem Content="Scroll, Zoom and Resize" Tag="{x:Static local:WheelBehavior.Custom}" />
        </ComboBox>
        <Label Content="Modifiers" Padding="0,4" />
        <ComboBox SelectedValue="{Binding ModifierScheme, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag">
          <ComboBoxItem Content="Default" Tag="{x:Static local:ModifierScheme.Default}" />
          <ComboBoxItem Content="Alternative" Tag="{x:Static local:ModifierScheme.Alternative}" />
        </ComboBox>
        <Label Content="Wheel Zoom Factor" Padding="0,4" />
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Width="36" Margin="4,0,0,0"
                     Text="{Binding ZoomFactor, StringFormat={}{0:0.0}}" />
          <Slider Minimum="1.1" Maximum="3.0" TickFrequency="0.1"
                  Value="{Binding ZoomFactor, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="Mouse Wheel Zoom Factor" />
        </DockPanel>
        <Label Content="Wheel Scroll Factor" Padding="0,4" />
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Width="36" Margin="4,0,0,0"
                     Text="{Binding ScrollFactor, StringFormat={}{0:0}}" />
          <Slider Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding ScrollFactor, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="Mouse Wheel Scroll Factor" />
        </DockPanel>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
