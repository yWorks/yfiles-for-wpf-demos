<demo:Demo x:Class="yWorks.Demo.LabelEditing.LabelEditingDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.LabelEditing">
  <demo:Demo.Resources>
    <Style x:Key="{x:Static ywpf:TextEditorInputMode.TextBoxStyleKey}" TargetType="TextBox">
      <Style.Triggers>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="local:TextBoxProperties.CustomHelper" Value="true"/>
            <Condition Property="local:TextBoxProperties.ValidText" Value="true"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="LightGray"/>
          <Setter Property="BorderBrush" Value="DarkBlue"/>
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="local:TextBoxProperties.CustomHelper" Value="true"/>
            <Condition Property="local:TextBoxProperties.ValidText" Value="false"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="LightPink"/>
          <Setter Property="BorderBrush" Value="DarkBlue"/>
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="local:TextBoxProperties.CustomHelper" Value="false"/>
            <Condition Property="local:TextBoxProperties.ValidText" Value="false"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="LightPink"/>
        </MultiTrigger>
      </Style.Triggers>
    </Style>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Label Edit Properties">
      <StackPanel x:Name="SettingsPanel">
        <Label Content="Label Creation" Padding="0,4" />
        <CheckBox Content="Allow label creation" IsChecked="{Binding LabelCreation}" />
        <Label Content="Label Editing" Padding="0,4" />
        <CheckBox Content="Allow label editing" IsChecked="{Binding LabelEditing}" />
        <Label Content="Hide Label During Editing" Padding="0,4" />
        <CheckBox Content="Hide label" IsChecked="{Binding HideLabel}" />
        <Label Content="Instant Typing" Padding="0,4" />
        <CheckBox Content="Start editing while typing" IsChecked="{Binding InstantTyping}" />
        <Label Content="Custom Label Helper" Padding="0,4" />
        <CheckBox Content="Use custom label helper" IsChecked="{Binding CustomLabelHelper}" />
        <Label Content="Editable Items" Padding="0,4" />
        <CheckBox Content="Nodes" IsChecked="{Binding NodesEnabled}" />
        <CheckBox Content="Edges" IsChecked="{Binding EdgesEnabled}" />
        <Label Content="Validation" Padding="0,4" />
        <CheckBox Content="Enable validation" IsChecked="{Binding ValidationEnabled}" />
        <Label Content="Pattern" Padding="0,4" />
        <TextBox Text="{Binding ValidationPattern, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding ValidationEnabled}"
                 Margin="0,0,0,8" />
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
