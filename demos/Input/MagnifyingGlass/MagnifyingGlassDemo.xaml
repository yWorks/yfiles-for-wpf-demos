<demo:Demo x:Class="yWorks.Demo.MagnifyingGlass.MagnifyingGlassDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           Background="White">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label Content="Lens Zoom" VerticalAlignment="Center" Margin="6,0" />
          <ComboBox x:Name="LensZoomSelector" Width="80" SelectedIndex="1"
                  ToolTip="Change the zoom level of the lens"
                  SelectionChanged="LensZoomSelector_SelectionChanged">
            <ComboBoxItem Content="1:1" Tag="1" />
            <ComboBoxItem Content="2x" Tag="2" />
            <ComboBoxItem Content="3x" Tag="3" />
            <ComboBoxItem Content="5x" Tag="5" />
          </ComboBox>
          <Label Content="Current Zom:" VerticalAlignment="Center" Margin="6,0" />
          <Label x:Name="zoomLevelLabel" Content="1.0" VerticalAlignment="Center" Margin="6,0" />
        </demo:DemoToolBar>
        <Grid x:Name="graphHost" ClipToBounds="True">
          <ywpf:GraphControl x:Name="graphControl" Background="White" />
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
