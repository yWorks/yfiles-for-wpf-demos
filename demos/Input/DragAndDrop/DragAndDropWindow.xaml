<Window x:Class="Demo.yFiles.Input.DragAndDrop.DragAndDropWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml" 
        xmlns:local="clr-namespace:Demo.yFiles.Input.DragAndDrop" 
        Title="Demo.yFiles.Graph.Input.DragAndDrop" Height="600" Width="800" Style="{StaticResource DemoWindow}"
        Loaded="OnLoaded">
    <Window.Resources>
        <local:NodeImageConverter x:Key="NodeStyleImageConverter"/>
        <DataTemplate x:Key="NodeListStyleTemplate">
            <Border BorderThickness="5" Mouse.PreviewMouseDown="OnTemplateMouseDown">
                <Image Source="{Binding Converter={StaticResource NodeStyleImageConverter}}"/>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <HeaderedContentControl Style="{StaticResource DemoStyle}">
        <HeaderedContentControl.Header>
            <RichTextBox BorderThickness="0" IsReadOnly="True">
                <FlowDocument>
                    <Paragraph>
                        This demo shows how to enable drag and drop functionality using the classes
                        <Run FontStyle="Italic" Text="NodeDropInputMode" /> and
                        <Run FontStyle="Italic" Text="LabelDropInputMode" />.
                    </Paragraph>
                    <Paragraph Style="{StaticResource HtmlH2}">
                        Things to Try
                    </Paragraph>
                    <List>
                        <ListItem>
                            <Paragraph>
                                Drag a node visualization from the palette panel onto the canvas to create a new node.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Drag a node/edge label from the palette panel onto a node/edge to create a new label.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Drag the node around on the canvas to see grid snapping.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Drag a node around near another node to see node to node snapping.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Drag a node over a group node to see group node highlighting. Additionally hold the
                                'Ctrl' key, if this node is not dragged from the palette panel.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Drop a node over a group node to place it inside the group. If this node is not dragged
                                from the palette panel, additionally hold the 'Ctrl' key.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Switch off the <Run FontStyle="Italic">Preview</Run> or the
                                <Run FontStyle="Italic">Snapping and Preview</Run> features.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Enable the usage of the drop location of labels for the label model. In this example the
                                label models of nodes and edges are <Run FontStyle="Italic">FreeLabelModels</Run> so the
                                labels will be positioned exactly at the drop location. If disabled, the model of the
                                dragged label from the palette will be used which in this demo will place labels
                                centered.
                            </Paragraph>
                        </ListItem>
                        <ListItem>
                            <Paragraph>
                                Select a node visualization of the palette panel and click on the canvas 
                                to create a node with the selected visualization.
                            </Paragraph>
                        </ListItem>
                    </List>
                </FlowDocument>
            </RichTextBox>
        </HeaderedContentControl.Header>
        <DockPanel>            
            <ToolBarTray Height="Auto" Name="toolBarTray" Width="Auto" DockPanel.Dock="Top">
                <ToolBar Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ToolBarTray}}}" Height="Auto" Name="toolBar">
                    <Button Command="Open"/>
                    <Button Command="SaveAs" CommandTarget="{Binding ElementName=graphControl}"/>
                    <Separator/>
                    <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}"  />
                    <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}"  />
                    <Separator/>
                    <Button Command="IncreaseZoom" CommandTarget="{Binding ElementName=graphControl}"  />
                    <Button Command="DecreaseZoom" CommandTarget="{Binding ElementName=graphControl}"  />
                    <Button Command="{x:Static ywpf:GraphCommands.FitGraphBounds}" CommandTarget="{Binding ElementName=graphControl}"  />
                    <Separator/>
                    <Label Content="Drag and Drop Features:" />
                    <ComboBox x:Name="featuresComboBox" SelectionChanged="FeatureSelectionChanged" MinWidth="140"/>
                    <ToggleButton Name="UseDragLocationToggle" IsChecked="False" Click="UseDropLocationForParameterChanged">
                        Use Drop Location for Label Layout Parameter
                    </ToggleButton>
                </ToolBar>
            </ToolBarTray>
            <ScrollViewer DockPanel.Dock="Left" Width="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ListView x:Name="styleListBox" ItemTemplate="{StaticResource NodeListStyleTemplate}" BorderThickness="0,0,5,0" BorderBrush="{StaticResource SecondaryBrush}" SelectionMode="Single"/>
            </ScrollViewer>
            <ywpf:GraphControl Width="Auto" Name="graphControl" FileOperationsEnabled="True" />
        </DockPanel>
    </HeaderedContentControl>
</Window>
