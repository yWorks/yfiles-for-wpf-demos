<demo:Demo x:Class="yWorks.Demo.DragFromComponent.DragFromComponentDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <AdornerDecorator>
    <demo:DemoView x:Name="demoView">
      <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
        <DockPanel>
          <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
            <Button Command="{x:Static input:ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=graphControl}" />
            <Button Command="{x:Static input:ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=graphControl}" />
          </demo:DemoToolBar>
          <ywpf:GraphControl x:Name="graphControl" />
        </DockPanel>
      </demo:ClippingBorder>
      <demo:SideBar Header="Drop panel">
        <ScrollViewer Width="215"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Width="200" Margin="8">
            <StackPanel x:Name="dropList"
                        MinHeight="60"
                        Background="#FFF7F7F7"
                        AllowDrop="True">
              <TextBlock x:Name="dropHere"
                         Margin="8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="Drop Here!" />
            </StackPanel>
            <Border Height="3" Margin="0,8" Background="#FFBBBBBB" />
            <Border x:Name="dropTrashcan"
                    Height="100"
                    Background="#FFF0F0F0"
                    AllowDrop="True">
              <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE74D;" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </demo:SideBar>
      <demo:Description Source="description.html" />
    </demo:DemoView>
  </AdornerDecorator>
</demo:Demo>
