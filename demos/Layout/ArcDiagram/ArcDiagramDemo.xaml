<demo:Demo x:Class="yWorks.Demo.ArcDiagram.ArcDiagramDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.ArcDiagram">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Label Content="Node Order:" VerticalAlignment="Center" />
          <ComboBox x:Name="nodeOrderComboBox" SelectedValuePath="Tag"
                  SelectedValue="{x:Static local:NodeOrder.FromSketch}"
                  VerticalAlignment="Center" MinWidth="150">
            <ComboBoxItem Content="From Sketch" Tag="{x:Static local:NodeOrder.FromSketch}" />
            <ComboBoxItem Content="Minimize Crossings" Tag="{x:Static local:NodeOrder.MinimizeCrossings}" />
            <ComboBoxItem Content="Topological" Tag="{x:Static local:NodeOrder.Topological}" />
          </ComboBox>
          <Separator />
          <Button Content="Layout" Click="OnArrangeClick" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
