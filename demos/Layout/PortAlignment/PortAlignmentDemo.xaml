<demo:Demo x:Class="yWorks.Demo.PortAlignment.PortAlignmentDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <CheckBox x:Name="togglePortAlignment" Content="Align Ports" IsChecked="True"
                  ToolTip="Align source and target ports with their edge paths" />
          <Separator Width="1" Height="22" Margin="8,0" />
          <Label Content="Minimum Port Distance" VerticalAlignment="Center" Margin="4,0" />
          <Slider x:Name="minimumPortDistance" Width="100" Minimum="0" Maximum="15"
                Value="2" TickFrequency="1" IsSnapToTickEnabled="True" />
          <Label x:Name="portDistanceLabel" Width="24" VerticalAlignment="Center" Margin="3,0" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
