<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="{x:Type FlowDocument}">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="PagePadding" Value="8,8,16,8" />
    <Setter Property="IsHyphenationEnabled" Value="True"/>
    <Setter Property="IsOptimalParagraphEnabled" Value="True"/>
  </Style>

  <Style TargetType="{x:Type Paragraph}">
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>

  <Style x:Key="SidebarSectionHeading" TargetType="{x:Type Paragraph}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,14,0,4" />
    <Setter Property="KeepWithNext" Value="True" />
  </Style>

  <Style TargetType="{x:Type BlockUIContainer}">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
</ResourceDictionary>