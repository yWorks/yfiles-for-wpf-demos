<demo:Demo x:Class="yWorks.Demo.Biofabrics.BiofabricsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:Demo.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Biofabrics;component/Resources/BiofabricsSidebarStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Background="White" CornerRadius="12" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="4*" />
          <RowDefinition Height="6*" />
        </Grid.RowDefinitions>
        <ywpf:GraphControl x:Name="circularGraphControl" Grid.Row="0" BorderThickness="0" />
        <ywpf:GraphControl x:Name="biofabricGraphControl" Grid.Row="1" BorderThickness="0" />
      </Grid>
    </demo:ClippingBorder>

    <demo:SideBar Header="Biofabric Settings">
      <FlowDocumentScrollViewer x:Name="SettingsPanel"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                IsToolBarVisible="False">
        <FlowDocument>
          <Paragraph Style="{StaticResource SidebarSectionHeading}">Datasets</Paragraph>
          <Paragraph>
            Load one of three datasets, each of different size and complexity, in order to highlight different aspects and advantages of biofabric visualizations: a company network, a logistics (ego) network, or a dynamic (high-frequency) trading network.
          </Paragraph>
          <BlockUIContainer>
            <StackPanel>
              <Label Content="Choose a dataset to load:" />
              <ComboBox ItemsSource="{Binding DatasetOptions}"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding SelectedDataset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </BlockUIContainer>

          <Paragraph Style="{StaticResource SidebarSectionHeading}">Styling Options</Paragraph>
          <Paragraph>
            Try out two different styling options for the visualized biofabric. On the one hand,
            <Italic>edge color mode</Italic> dictates what properties of the data determine each edge's color, i.e., the node groups that said edge connects, the edge group that the edge maps to, or no coloring whatsoever. On the other hand,
            <Italic>node-width mode</Italic> dictates how wide each node is drawn, i.e., the entire width of the canvas, only until its final edge, or only from its first until its final edge.
          </Paragraph>
          <BlockUIContainer>
            <StackPanel>
              <Label Content="Choose an edge color mode:" />
              <ComboBox ItemsSource="{Binding EdgeColorModeOptions}" SelectedValuePath="Value"
                        SelectedValue="{Binding EdgeColorMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Label Content="Choose a node-width mode:" />
              <ComboBox ItemsSource="{Binding NodeWidthModeOptions}" SelectedValuePath="Value"
                        SelectedValue="{Binding NodeWidthMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </BlockUIContainer>

          <Paragraph Style="{StaticResource SidebarSectionHeading}">Node/Edge Ordering</Paragraph>
          <Paragraph>
            Biofabrics offer a unique advantage over most node-link diagrammatic representations: the ability to order nodes and edges. Here, you can set how nodes and edges are ordered (within their respective groups). By default, biofabrics normally order nodes by their degree (so-called
            <Italic>DegreeDescending</Italic>) and edges by their edge length, but, where applicable, they can also be sorted by their labels.
          </Paragraph>
          <BlockUIContainer>
            <StackPanel>
              <Label Content="Choose an edge sorting mode:" />
              <ComboBox ItemsSource="{Binding EdgeOrderingOptions}" SelectedValuePath="Value"
                        SelectedValue="{Binding EdgeOrdering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Label Content="Choose a node sorting mode:" />
              <ComboBox ItemsSource="{Binding NodeOrderingOptions}" SelectedValuePath="Value"
                        SelectedValue="{Binding NodeOrdering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </BlockUIContainer>

          <Paragraph Style="{StaticResource SidebarSectionHeading}">Grouping Options</Paragraph>
          <Paragraph>
            Finally, biofabrics offer the ability to straightforwardly group nodes and edges visually into blocks. Here, you can enable and disable the grouping of nodes and edges as well as determine how these node/edge groups are sorted, i.e., based on the group's label or based on its cardinality (size).
          </Paragraph>
          <BlockUIContainer>
            <StackPanel>
              <CheckBox Content="Group Edges"
                        IsChecked="{Binding EdgeGrouping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}" />
              <Label Content="Choose an edge group sorting mode:" />
              <ComboBox ItemsSource="{Binding EdgeGroupOrderingOptions}" SelectedValuePath="Value"
                        SelectedValue="{Binding EdgeGroupOrdering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEdgeGroupOrderingEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="Group Nodes"
                        IsChecked="{Binding NodeGrouping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}" />
              <Label Content="Choose a node group sorting mode:" />
              <ComboBox ItemsSource="{Binding NodeGroupOrderingOptions}" SelectedValuePath="Value"
                        SelectedValue="{Binding NodeGroupOrdering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsNodeGroupOrderingEnabled}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </BlockUIContainer>

          <Paragraph Style="{StaticResource SidebarSectionHeading}">Data Description</Paragraph>
          <Paragraph FontWeight="SemiBold">
            <Run Text="{Binding DatasetTitle, Mode=OneWay}" />
          </Paragraph>
          <Paragraph>
            <Run Text="{Binding DatasetDescription, Mode=OneWay}" />
          </Paragraph>
        </FlowDocument>
      </FlowDocumentScrollViewer>
    </demo:SideBar>

    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>