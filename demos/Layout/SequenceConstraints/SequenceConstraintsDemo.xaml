<demo:Demo x:Class="yWorks.Demo.SequenceConstraints.SequenceConstraintsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           Background="CornflowerBlue">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top">
          <Button x:Name="newGraphButton" Content="&#xE7C3;" ToolTip="Create Random Graph" Click="OnNewGraphClick" />
          <Separator />
          <Button x:Name="enableAllConstraintsButton" Content="{StaticResource IconAsterisk}" ToolTip="Add constraints to all nodes" Click="OnEnableAllConstraintsClick" />
          <Button x:Name="disableAllConstraintsButton" Content="{StaticResource IconClose}" ToolTip="Remove constraints from all nodes" Click="OnDisableAllConstraintsClick" />
          <Separator />
          <Button x:Name="layoutButton" ToolTip="Run Hierarchical Layout" Click="OnLayoutClick">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Text="&#xE768;" Margin="0 0 4 0" />
              <TextBlock Text="Layout" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
