<demo:Demo x:Class="yWorks.Demo.PartialLayout.PartialLayoutDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:Demo.Resources>
    <DataTemplate x:Key="EnumChoiceTemplate">
      <TextBlock Text="{Binding Label}" />
    </DataTemplate>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" x:Name="demoToolBar" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Content="&#xE72E;" ToolTip="Fixate selected nodes and edges" Click="OnLockSelection" />
          <Button Content="&#xE785;" ToolTip="Free selected nodes and edges" Click="OnUnlockSelection" />
          <Separator />
          <Label Content="Scenario:" VerticalAlignment="Center" Margin="6,0,4,0" />
          <ComboBox x:Name="sampleComboBox" Width="130" SelectedValuePath="Tag"
                  ToolTip="Choose a predefined sample">
            <ComboBoxItem Content="Hierarchical" Tag="hierarchical" />
            <ComboBoxItem Content="Orthogonal" Tag="orthogonal" />
            <ComboBoxItem Content="Organic" Tag="organic" />
            <ComboBoxItem Content="Circular" Tag="circular" />
          </ComboBox>
          <Button Content="Refresh" ToolTip="Refresh sample graph" Click="OnRefresh" />
          <Separator />
          <Button Content="Layout" ToolTip="Run Partial Layout" Click="OnLayout" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar x:Name="interactionPanel" Header="Layout Settings">
      <StackPanel>
        <TextBlock Text="Component Assignment" FontWeight="Bold" Margin="0,4" />
        <ComboBox ItemsSource="{Binding ComponentAssignments}"
                  ItemTemplate="{StaticResource EnumChoiceTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding ComponentAssignment, Mode=TwoWay}" />
        <TextBlock Text="Subgraph Layout" FontWeight="Bold" Margin="0,4" />
        <ComboBox ItemsSource="{Binding SubgraphLayouts}"
                  ItemTemplate="{StaticResource EnumChoiceTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SubgraphLayout, Mode=TwoWay}" />
        <TextBlock Text="Subgraph Positioning" FontWeight="Bold" Margin="0,4" />
        <ComboBox ItemsSource="{Binding SubgraphPlacements}"
                  ItemTemplate="{StaticResource EnumChoiceTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SubgraphPlacement, Mode=TwoWay}" />
        <TextBlock Text="Edge Routing Style" FontWeight="Bold" Margin="0,4" />
        <ComboBox ItemsSource="{Binding EdgeRoutingStyles}"
                  ItemTemplate="{StaticResource EnumChoiceTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding EdgeRoutingStyle, Mode=TwoWay}" />
        <TextBlock Text="Layout Orientation" FontWeight="Bold" Margin="0,4" />
        <ComboBox ItemsSource="{Binding LayoutOrientations}"
                  ItemTemplate="{StaticResource EnumChoiceTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding LayoutOrientation, Mode=TwoWay}" />
        <TextBlock Text="Minimum Node Distance" FontWeight="Bold" Margin="0,4" />
        <TextBox Text="{Binding MinimumNodeDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,4" />
        <CheckBox Content="Allow Mirroring" IsChecked="{Binding AllowMirroring, Mode=TwoWay}"
                  Margin="0,2" />
        <CheckBox Content="Node Snapping" IsChecked="{Binding NodeSnapping, Mode=TwoWay}"
                  Margin="0,2" />
        <TextBlock Text="Configuration Options" FontSize="16" FontWeight="Bold" Margin="0,16,0,6" />
        <TextBlock Text="Component Assignment" FontWeight="Bold" Margin="0,4,0,0" />
        <TextBlock Text="Partial nodes as single nodes or in connected components with a common subgraph layout."
                   TextWrapping="Wrap" />
        <TextBlock Text="Subgraph Layout" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="The layout algorithm to apply to subgraph components: hierarchical, orthogonal, organic or circular. Furthermore, the components can remain Unchanged."
                   TextWrapping="Wrap" />
        <TextBlock Text="Subgraph Positioning Strategy" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="Subgraph components can either be close to the barycenter of their graph neighbors or close to their original position (From Sketch)."
                   TextWrapping="Wrap" />
        <TextBlock Text="Edge Routing Style" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="Partial edges and edges between different subgraph components (so-called inter-edges) are routed straight-line, orthogonal, or organic. The algorithm can also automatically choose a suitable routing strategy."
                   TextWrapping="Wrap" />
        <TextBlock Text="Layout Orientation" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="The layout orientation for the layout of subgraph components. Automatic specifies that the orientation should be determined automatically."
                   TextWrapping="Wrap" />
        <TextBlock Text="Minimum Node Distance" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="The minimum distance between two adjacent nodes." TextWrapping="Wrap" />
        <TextBlock Text="Allow Mirroring" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="Allows mirroring of subgraph components to improve the layout quality." TextWrapping="Wrap" />
        <TextBlock Text="Node Snapping:" FontWeight="Bold" Margin="0,8,0,0" />
        <TextBlock Text="The algorithm tries to align nodes with each other." TextWrapping="Wrap" />
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
