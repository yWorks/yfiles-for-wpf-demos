<demo:Demo x:Class="yWorks.Demo.HierarchicalGridComponents.HierarchicalGridComponentsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" x:Name="demoToolBar" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Content="Layout" ToolTip="Run layout with current settings" Click="LayoutButtonClick" />
          <Separator Width="1" Height="22" Margin="8,0" />
          <CheckBox Content="Grid Components"
                  ToolTip="Toggles grid components for HierarchicalLayout"
                  IsEnabled="{Binding IsToggleEnabled}"
                  IsChecked="{Binding UseGridComponents, Mode=TwoWay}" />
          <Separator Width="1" Height="22" Margin="8,0" />
          <ComboBox Width="145"
                  ToolTip="Select a bus structure preset"
                  IsEnabled="{Binding IsBusSettingsEnabled}"
                  ItemsSource="{Binding BusPresetOptions}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Preset, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Label Content="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Separator Width="1" Height="22" Margin="8,0" />
          <Label Content="Max. Nodes before Bus:" VerticalAlignment="Center" Margin="4,0" />
          <Slider Width="100" Minimum="0" Maximum="20" TickFrequency="1"
                IsEnabled="{Binding IsCustomSettingsEnabled}"
                Value="{Binding BeforeBusLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Label Width="44" Content="{Binding BeforeBusLabel}"
                   VerticalAlignment="Center" Margin="3,0" />
          <Separator Width="1" Height="22" Margin="8,0" />
          <Label Content="Max. Nodes after Bus:" VerticalAlignment="Center" Margin="4,0" />
          <Slider Width="100" Minimum="0" Maximum="20" TickFrequency="1"
                IsEnabled="{Binding IsCustomSettingsEnabled}"
                Value="{Binding AfterBusLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Label Width="44" Content="{Binding AfterBusLabel}"
                   VerticalAlignment="Center" Margin="3,0" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Background="White" Source="description.html" />
  </demo:DemoView>
</demo:Demo>
