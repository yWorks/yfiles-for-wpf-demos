<demo:Demo x:Class="yWorks.Demo.OrganicSubstructures.OrganicSubstructuresDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" x:Name="demoToolBar"  ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
        </demo:DemoToolBar>
        <Grid>
          <ywpf:GraphControl x:Name="graphControl" />
          <primitives:Popup x:Name="typePopup"
                          PlacementTarget="{Binding ElementName=graphControl}"
                          Placement="Relative"
                          StaysOpen="True">
            <Border Background="#F2FFFFFF" BorderBrush="LightGray" BorderThickness="1" Padding="6">
              <StackPanel>
                <TextBlock Text="Type" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <WrapPanel x:Name="typePalette" Width="144" />
              </StackPanel>
            </Border>
          </primitives:Popup>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar x:Name="interactionPanel" Header="Layout Settings" ExpandedWidth="300">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="settingsPanel" Margin="10">
          <TextBlock Text="Sample Graph" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ComboBox x:Name="sampleComboBox" DisplayMemberPath="Text" SelectedIndex="-1" />
          <TextBlock Text="Substructure Layout" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" />
          <TextBlock Text="Cycles" />
          <ComboBox x:Name="cycleStyleComboBox" SelectedValuePath="Value" DisplayMemberPath="Text"
                      SelectedValue="{Binding CycleStyle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
          <TextBlock Text="Chains" />
          <ComboBox x:Name="chainStyleComboBox" SelectedValuePath="Value" DisplayMemberPath="Text"
                      SelectedValue="{Binding ChainStyle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
          <TextBlock Text="Star" />
          <ComboBox x:Name="starStyleComboBox" SelectedValuePath="Value" DisplayMemberPath="Text"
                      SelectedValue="{Binding StarStyle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
          <TextBlock Text="Parallel" />
          <ComboBox x:Name="parallelStyleComboBox" SelectedValuePath="Value" DisplayMemberPath="Text"
                      SelectedValue="{Binding ParallelStyle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
          <TextBlock Text="Tree" />
          <ComboBox x:Name="treeStyleComboBox" SelectedValuePath="Value" DisplayMemberPath="Text"
                      SelectedValue="{Binding TreeStyle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
          <TextBlock Text="Groups" />
          <ComboBox x:Name="groupScopeComboBox" SelectedValuePath="Value" DisplayMemberPath="Text"
                      SelectedValue="{Binding GroupScope, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
          <CheckBox Content="Use Edge Grouping" IsChecked="{Binding UseEdgeGrouping, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
          <TextBlock Text="Node Types" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" />
          <CheckBox Content="Consider Node Types" IsChecked="{Binding ConsiderNodeTypes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
          <CheckBox Content="Separate Parallel Structures by Type"
                      IsChecked="{Binding ParallelTypeSeparation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
          <CheckBox Content="Separate Star Structures by Type"
                      IsChecked="{Binding StarTypeSeparation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
          <Button x:Name="applyLayoutButton" Content="Apply Layout" Padding="8,5" HorizontalAlignment="Stretch" />
        </StackPanel>
      </ScrollViewer>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
