<demo:Demo x:Class="yWorks.Demo.MultiPage.MultiPageDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label Content="Page:" VerticalAlignment="Center" Margin="5 0 0 0"/>
          <Button x:Name="PreviousPage" Content="&#xE760;" Click="PreviousPage_Click" IsEnabled="False" />
          <TextBox x:Name="pageNumberTextBox" Width="40" KeyDown="PageNumberTextBox_KeyDown" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
          <Button x:Name="NextPage" Content="&#xE761;" Click="NextPage_Click" IsEnabled="False" />
        </demo:DemoToolBar>
        <Grid x:Name="mainGrid" Background="White">
          <Grid.Resources>
            <Style x:Key="NormalNodeTemplate" TargetType="ywpf:NodeControl">
              <Setter Property="Background" Value="#FF17BEBB" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ywpf:NodeControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF094C4B"
                          BorderThickness="2" CornerRadius="5" ToolTip="A normal node." />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="ConnectorNodeTemplate" TargetType="ywpf:NodeControl">
              <Setter Property="Background" Value="#FFFF6C00" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ywpf:NodeControl">
                    <Border Background="{TemplateBinding Background}" BorderThickness="2" CornerRadius="5"
                          ToolTip="A connector node. Click to navigate to the connected page.">
                      <Border.BorderBrush>
                        <SolidColorBrush Color="#FF662B00" />
                      </Border.BorderBrush>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="ProxyNodeTemplate" TargetType="ywpf:NodeControl">
              <Setter Property="Background" Value="#FF76B041" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ywpf:NodeControl">
                    <Border x:Name="NodeBorder" Background="{TemplateBinding Background}" BorderThickness="2"
                          CornerRadius="5"
                          ToolTip="A proxy node. Click to navigate to the page containing the proxy reference node.">
                      <Border.BorderBrush>
                        <SolidColorBrush x:Name="borderBrush" Color="#FF2F461A" />
                      </Border.BorderBrush>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:1" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity"
                                             Duration="0:0:1" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="ProxyReferenceNodeTemplate" TargetType="ywpf:NodeControl">
              <Setter Property="Background" Value="#FFAB2346" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ywpf:NodeControl">
                    <Border Background="{TemplateBinding Background}" BorderThickness="2" CornerRadius="5"
                          ToolTip="A proxy reference node. Click to navigate to the page containing the referenced proxy node.">
                      <Border.BorderBrush>
                        <SolidColorBrush x:Name="borderBrush" Color="#FF440E1C" />
                      </Border.BorderBrush>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:1" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity"
                                             Duration="0:0:1" />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ywpf:GraphControl x:Name="originalGraphControl" Grid.Column="0" Background="White">
            <ywpf:GraphControl.InputMode>
              <ywpf:GraphViewerInputMode SelectableItems="None" ClickableItems="None" />
            </ywpf:GraphControl.InputMode>
          </ywpf:GraphControl>
          <GridSplitter x:Name="gridSplitter" Grid.Column="1" Width="5" ResizeBehavior="PreviousAndNext"
                      IsEnabled="False" />
          <Grid Grid.Column="2">
            <ywpf:GraphControl x:Name="graphControl" Background="White" />
            <Grid x:Name="loadingIndicator" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="100" />
                <RowDefinition Height="0.5*" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="1" Background="#AA000000" />
              <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">Loading...</TextBlock>
                <TextBlock HorizontalAlignment="Center" Margin="0,5" VerticalAlignment="Center">
                  <Hyperlink Click="StopLayoutButtonClick" Foreground="White">
                    <TextBlock x:Name="StopButton">Stop</TextBlock>
                  </Hyperlink>
                </TextBlock>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Layout Settings" Background="White" ExpandedWidth="260">
      <Grid Margin="12">
        <Grid.Resources>
          <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5" />
          </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="85" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0">Page Width</Label>
        <TextBox x:Name="pageWidthTextBox" Grid.Row="0" Grid.Column="1">800</TextBox>
        <Label Grid.Row="1" Grid.Column="0">Page Height</Label>
        <TextBox x:Name="pageHeightTextBox" Grid.Row="1" Grid.Column="1">800</TextBox>
        <Label Grid.Row="2" Grid.Column="0">Core Layout</Label>
        <ComboBox x:Name="coreLayoutComboBox" Grid.Row="2" Grid.Column="1" />
        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Click="RunLayout_Click" Margin="5,15,0,5">Run Layout</Button>
        <ToggleButton x:Name="showInputGraphButton" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                      Click="ShowInputGraph_Click" Margin="5,5,0,5">
          Show Input Graph
        </ToggleButton>
      </Grid>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
