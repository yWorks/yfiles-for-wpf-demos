<demo:Demo x:Class="yWorks.Demo.TreeMap.TreeMapDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">You are here:  </Label>
          <demo:Breadcrumbs x:Name="navigation" IsLastItemClickable="True" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Tree Map Layout" IsExpanded="True" Width="310">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <TextBlock Text="Zooming Mode" Margin="0,0,0,4" />
          <ComboBox x:Name="zoomingModeBox" SelectedIndex="0" Margin="0,0,0,12">
            <ComboBoxItem Content="Constant Size" />
            <ComboBoxItem Content="Aspect Ratio of Root" />
          </ComboBox>
          <TextBlock Text="Tiling Algorithm" Margin="0,0,0,4" />
          <ComboBox x:Name="tilingAlgorithmBox" SelectedIndex="0" Margin="0,0,0,12">
            <ComboBoxItem Content="Squarified" />
            <ComboBoxItem Content="Slice-And-Dice" />
          </ComboBox>
          <TextBlock Text="Aspect Ratio" />
          <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="aspectRatioValue" DockPanel.Dock="Right" Width="34" Text="1" TextAlignment="Right" />
            <Slider x:Name="aspectRatioSlider" Minimum="1" Maximum="10" Value="1" IsSnapToTickEnabled="True"
                    TickFrequency="1" />
          </DockPanel>
          <TextBlock Text="Sorting Criterion" Margin="0,0,0,4" />
          <ComboBox x:Name="sortingCriterionBox" SelectedIndex="0" Margin="0,0,0,12">
            <ComboBoxItem Content="Size" />
            <ComboBoxItem Content="Name" />
          </ComboBox>
          <TextBlock Text="Sorting Order" Margin="0,0,0,4" />
          <ComboBox x:Name="sortingOrderBox" SelectedIndex="0" Margin="0,0,0,12">
            <ComboBoxItem Content="Descending" />
            <ComboBoxItem Content="Ascending" />
          </ComboBox>
          <TextBlock Text="Spacing" />
          <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="spacingValue" DockPanel.Dock="Right" Width="34" Text="2" TextAlignment="Right" />
            <Slider x:Name="spacingSlider" Minimum="0" Maximum="20" Value="2" IsSnapToTickEnabled="True"
                    TickFrequency="1" />
          </DockPanel>
          <TextBlock Text="Minimum Node Width" />
          <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="minimumWidthValue" DockPanel.Dock="Right" Width="34" Text="5" TextAlignment="Right" />
            <Slider x:Name="minimumWidthSlider" Minimum="5" Maximum="50" Value="5" IsSnapToTickEnabled="True"
                    TickFrequency="1" />
          </DockPanel>
          <TextBlock Text="Minimum Node Height" />
          <DockPanel Margin="0,0,0,16">
            <TextBlock x:Name="minimumHeightValue" DockPanel.Dock="Right" Width="34" Text="5" TextAlignment="Right" />
            <Slider x:Name="minimumHeightSlider" Minimum="5" Maximum="50" Value="5" IsSnapToTickEnabled="True"
                    TickFrequency="1" />
          </DockPanel>
          <Button x:Name="applyLayoutButton" Content="Apply" HorizontalAlignment="Stretch" />
        </StackPanel>
      </ScrollViewer>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
