<demo:Demo x:Class="yWorks.Demo.NodeTypes.NodeTypesDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
          >
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Button x:Name="resetButton" Content="Reset Graph" ToolTip="Reset Graph" />
          <Separator />
          <Label Content="Sample:" VerticalAlignment="Center" Margin="8,0,4,0" />
          <ComboBox x:Name="sampleComboBox" Width="170" />
          <Separator />
          <Button x:Name="layoutButton" Content="Layout" ToolTip="Run Layout" />
        </demo:DemoToolBar>
        <Grid>
          <ywpf:GraphControl x:Name="graphControl" />
          <primitives:Popup x:Name="typePopup"
                          PlacementTarget="{Binding ElementName=graphControl}"
                          Placement="Relative"
                          StaysOpen="True">
            <Border x:Name="typePalette" Background="#F2FFFFFF" BorderBrush="LightGray" BorderThickness="1" Padding="6">
              <StackPanel>
                <TextBlock Text="Type" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="type0Button" Width="30" Height="30" Margin="2" ToolTip="Set type 1" />
                  <Button x:Name="type1Button" Width="30" Height="30" Margin="2" ToolTip="Set type 2" />
                  <Button x:Name="type2Button" Width="30" Height="30" Margin="2" ToolTip="Set type 3" />
                </StackPanel>
              </StackPanel>
            </Border>
          </primitives:Popup>
          <Border x:Name="loadingPopup"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                Margin="0,0,0,80"
                Background="#E6000000"
                Padding="12"
                IsHitTestVisible="False">
            <TextBlock x:Name="loadingMessage" Foreground="White" FontSize="24" TextAlignment="Center" />
          </Border>
        </Grid>
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
