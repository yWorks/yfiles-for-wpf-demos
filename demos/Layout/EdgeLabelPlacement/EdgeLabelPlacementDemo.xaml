<demo:Demo x:Class="yWorks.Demo.EdgeLabelPlacement.EdgeLabelPlacementDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Label Content="Layout:" VerticalAlignment="Center" />
          <ComboBox x:Name="layoutComboBox" Width="220"
                  ItemsSource="{Binding Layouts}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedLayout}" />
          <Button Content="Layout" Click="LayoutButton_OnClick" IsEnabled="{Binding IsLayoutEnabled}" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar Header="Edge Label Properties">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
          <TextBlock Text="Edge Label Properties" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Text="Text" Margin="0,4,0,3" />
          <TextBox Text="{Binding LabelText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                   MinHeight="42" TextWrapping="Wrap" />
          <TextBlock Text="Distance to Edge" Margin="0,12,0,3" />
          <TextBox Text="{Binding DistanceToEdgeText, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="Placement Along Edge" Margin="0,12,0,3" />
          <ComboBox ItemsSource="{Binding PlacementOptions}" SelectedItem="{Binding Placement}" />
          <TextBlock Text="Side of Edge" Margin="0,12,0,3" />
          <ComboBox ItemsSource="{Binding SideOptions}" SelectedItem="{Binding Side}" />
          <TextBlock Text="Side Reference" Margin="0,12,0,3" />
          <ComboBox ItemsSource="{Binding SideReferenceOptions}" SelectedItem="{Binding SideReference}" />
          <TextBlock Text="Angle (in Degrees)" Margin="0,12,0,3" />
          <TextBox Text="{Binding AngleText, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="Angle Reference" Margin="0,12,0,3" />
          <ComboBox ItemsSource="{Binding AngleReferenceOptions}" SelectedItem="{Binding AngleReference}" />
          <TextBlock Text="Angle Rotation on Right Side" Margin="0,12,0,3" />
          <ComboBox ItemsSource="{Binding AngleRotationOptions}" SelectedItem="{Binding AngleRotation}" />
          <CheckBox Content="Add 180° on Right Side" Margin="0,12,0,4"
                    IsChecked="{Binding AddHalfRotationOnRightSide}" />
        </StackPanel>
      </ScrollViewer>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
