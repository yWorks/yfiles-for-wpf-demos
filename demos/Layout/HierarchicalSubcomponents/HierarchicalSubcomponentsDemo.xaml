<demo:Demo x:Class="yWorks.Demo.HierarchicalSubcomponents.HierarchicalSubcomponentsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           Background="CornflowerBlue">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label Content="Layout" VerticalAlignment="Center" Margin="8,0,4,0" />
          <ComboBox Width="135" ItemsSource="{Binding LayoutOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedLayout, UpdateSourceTrigger=PropertyChanged}" />
          <Label Content="Orientation" VerticalAlignment="Center" Margin="8,0,4,0" />
          <ComboBox Width="135" ItemsSource="{Binding OrientationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedOrientation, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OrientationEnabled}" />
          <Label Content="Placement" VerticalAlignment="Center" Margin="8,0,4,0" />
          <ComboBox Width="150" ItemsSource="{Binding PlacementPolicyOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPlacementPolicy, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Add Subcomponent" ToolTip="Add the selected nodes to a subcomponent" IsEnabled="{Binding CanChangeSubcomponents}" Click="CreateSubcomponent_Click" Margin="8,0,2,0" />
          <Button Content="Remove Subcomponent" ToolTip="Remove the selected nodes from their subcomponents" IsEnabled="{Binding CanChangeSubcomponents}" Click="RemoveSubcomponent_Click" Margin="2,0" />
          <Button Content="Layout" ToolTip="Run hierarchical layout" IsEnabled="{Binding CanRunLayout}" Click="RunLayout_Click" Margin="2,0,4,0" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
