<demo:Demo x:Class="yWorks.Demo.CircularSubstructures.CircularSubstructuresDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" x:Name="demoToolBar" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar x:Name="interactionPanel" Header="Circular Substructures">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="settingsPanel" Margin="10">
          <TextBlock Text="Sample Graph" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ComboBox x:Name="sampleComboBox" SelectedIndex="-1">
            <ComboBoxItem Content="Single Star" Tag="singleStar" />
            <ComboBoxItem Content="Multiple Stars" Tag="multipleStars" />
          </ComboBox>
          <TextBlock Text="Substructure Layout" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Text="Star" />
          <ComboBox x:Name="starStyleComboBox"
                    SelectedItem="{Binding StarSubstructureStyle, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,2,0,8" />
          <TextBlock Text="Node Types" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6" />
          <CheckBox Content="Consider Node Types"
                    IsChecked="{Binding ConsiderNodeTypes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
          <CheckBox Content="Separate Star Structures by Type"
                    IsChecked="{Binding StarSubstructureTypeSeparation, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,8" />
          <WrapPanel x:Name="typePalette" Margin="0,0,0,10" />
          <Button x:Name="applyLayoutButton" Content="Apply Layout" Padding="8,5" HorizontalAlignment="Stretch" />
        </StackPanel>
      </ScrollViewer>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
