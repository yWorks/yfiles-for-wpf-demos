<demo:Demo x:Class="yWorks.Demo.ViewportLimiter.ViewportLimiterDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <ToggleButton x:Name="isometricViewToggle" Content="Isometric View" ToolTip="Toggles Isometric Projection"
                      IsChecked="{Binding IsometricView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar x:Name="settingsPanel" Header="Viewport Limiter Settings">
      <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <TextBlock Text="Limiting Policy" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ComboBox SelectedValuePath="Value"
                    SelectedValue="{Binding Policy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,12">
            <ComboBoxItem Content="{x:Static ywpf:ViewportLimitingPolicy.WithinMargins}">
              <ComboBoxItem.ContentTemplate>
                <DataTemplate><TextBlock Text="Within Margins"/></DataTemplate>
              </ComboBoxItem.ContentTemplate>
            </ComboBoxItem>
            <ComboBoxItem Content="{x:Static ywpf:ViewportLimitingPolicy.TowardsLimit}">
              <ComboBoxItem.ContentTemplate>
                <DataTemplate><TextBlock Text="Towards Limit"/></DataTemplate>
              </ComboBoxItem.ContentTemplate>
            </ComboBoxItem>
            <ComboBoxItem Content="{x:Static ywpf:ViewportLimitingPolicy.Strict}">
              <ComboBoxItem.ContentTemplate>
                <DataTemplate><TextBlock Text="Strict"/></DataTemplate>
              </ComboBoxItem.ContentTemplate>
            </ComboBoxItem>
            <ComboBoxItem Content="{x:Static ywpf:ViewportLimitingPolicy.Unrestricted}">
              <ComboBoxItem.ContentTemplate>
                <DataTemplate><TextBlock Text="Unrestricted"/></DataTemplate>
              </ComboBoxItem.ContentTemplate>
            </ComboBoxItem>
          </ComboBox>
          <CheckBox Content="Strict Bounds Containment"
                    IsChecked="{Binding StrictBoundsContainment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,18" />
          <TextBlock Text="Viewport Content Margins" FontWeight="SemiBold" />
          <TextBlock Text="Configures the margins of the viewport in the view coordinate system around the content bounds."
                     TextWrapping="Wrap" Margin="0,4,0,8" />
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MarginLeft, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Top" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MarginTop, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Right" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MarginRight, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bottom" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MarginBottom, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
          </Grid>
          <TextBlock Text="Minimum Viewport Content Ratio" FontWeight="SemiBold" />
          <TextBlock Text="Configures the percentage of the viewport width and height that should be reserved at least when Viewport Content Margins are defined."
                     TextWrapping="Wrap" Margin="0,4,0,8" />
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" VerticalAlignment="Center" Margin="0,3" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding RatioWidth}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Width="28" Margin="4,8,0,0" Text="{Binding RatioWidth, StringFormat={}{0:0.0}}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Height" VerticalAlignment="Center" Margin="0,3" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding RatioHeight}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Width="28" Margin="4,8,0,0" Text="{Binding RatioHeight, StringFormat={}{0:0.0}}" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </demo:SideBar>
    <demo:Description Background="White" Source="description.html" />
  </demo:DemoView>
</demo:Demo>
