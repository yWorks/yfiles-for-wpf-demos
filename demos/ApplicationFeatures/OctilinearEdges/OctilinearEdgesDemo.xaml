<demo:Demo x:Class="yWorks.Demo.OctilinearEdges.OctilinearEdgesDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="Open" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Save" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Button Command="Cut" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Copy" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Paste" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <Button Command="Undo" CommandTarget="{Binding ElementName=graphControl}" />
          <Button Command="Redo" CommandTarget="{Binding ElementName=graphControl}" />
          <Separator />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
            <Label Content="Octilinear Segment Length" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Minimum="0" Maximum="80" Value="30" Width="110" VerticalAlignment="Center" ValueChanged="OnSegmentLengthChanged"/>
          </StackPanel>
          <Separator />
          <Button ToolTip="Applies a hierarchical layout with octilinear edge routing" Content="Apply Layout" Click="OnApplyLayoutClicked" />
          <Button ToolTip="Applies an octilinear edge routing" Content="Apply Router" Click="OnApplyRouterClicked" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
