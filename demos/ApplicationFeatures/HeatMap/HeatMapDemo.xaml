<demo:Demo x:Class="yWorks.Demo.HeatMap.HeatMapDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:y="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos">
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
          <Label Content="Heat Map Colors:" VerticalContentAlignment="Center" />
          <ComboBox x:Name="gradientComboBox"
                  MinWidth="190"
                  SelectionChanged="GradientChanged">
            <ComboBoxItem Content="Default rainbow">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#0A0000FF" Offset="0" />
                  <GradientStop Color="#C800FFFF" Offset="0.25" />
                  <GradientStop Color="#00FF00" Offset="0.5" />
                  <GradientStop Color="#FFFF00" Offset="0.75" />
                  <GradientStop Color="#FF0000" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Red - yellow - blue">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#884575B5" Offset="0" />
                  <GradientStop Color="#FFFFBF" Offset="0.5" />
                  <GradientStop Color="#D73027" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Yellow - orange - purple">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#AA30123B" Offset="0" />
                  <GradientStop Color="#FF6D00" Offset="0.5" />
                  <GradientStop Color="#FFF200" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Red - orange - yellow">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#FFFF00" Offset="0" />
                  <GradientStop Color="#FFA500" Offset="0.5" />
                  <GradientStop Color="#FF0000" Offset="0.9" />
                  <GradientStop Color="#8B0000" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Yellow - green - blue">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#0000204A" Offset="0" />
                  <GradientStop Color="#3B6EA0" Offset="0.5" />
                  <GradientStop Color="#F6F3A4" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Shades of blue">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#F7FBFF" Offset="0" />
                  <GradientStop Color="#6BAED6" Offset="0.5" />
                  <GradientStop Color="#08306B" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Shades of red">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#FFF5F0" Offset="0" />
                  <GradientStop Color="#FC9272" Offset="0.5" />
                  <GradientStop Color="#99000D" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Transparent - red">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#FFC80000" Offset="0" />
                  <GradientStop Color="#00C80000" Offset="0.8" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Orange - purple - blue">
              <ComboBoxItem.Tag>
                <GradientStopCollection>
                  <GradientStop Color="#AA0D0887" Offset="0" />
                  <GradientStop Color="#7E03A8" Offset="0.5" />
                  <GradientStop Color="#FCA636" Offset="1" />
                </GradientStopCollection>
              </ComboBoxItem.Tag>
            </ComboBoxItem>
          </ComboBox>
          <Separator />
          <Label Content="Background:" VerticalContentAlignment="Center" />
          <ComboBox x:Name="backgroundComboBox"
                  MinWidth="125"
                  SelectionChanged="BackgroundChanged">
            <ComboBoxItem Content="White">
              <ComboBoxItem.Tag>
                <SolidColorBrush Color="White" />
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Light Gray">
              <ComboBoxItem.Tag>
                <SolidColorBrush Color="LightGray" />
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Dark Gray">
              <ComboBoxItem.Tag>
                <SolidColorBrush Color="DarkGray" />
              </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="Black">
              <ComboBoxItem.Tag>
                <SolidColorBrush Color="Black" />
              </ComboBoxItem.Tag>
            </ComboBoxItem>
          </ComboBox>
        </demo:DemoToolBar>
        <y:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
