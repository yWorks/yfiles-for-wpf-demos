<demo:Demo x:Class="yWorks.Demo.GridSnapping.GridSnappingDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
           xmlns:local="clr-namespace:yWorks.Demo.GridSnapping">
  <demo:Demo.Resources>
    <local:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    <Style x:Key="ColorSwatchRadioButton" TargetType="{x:Type RadioButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="SwatchBorder" Padding="2" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwatchBorder" Property="Background" Value="DodgerBlue" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom, Editing" CommandTarget="{Binding ElementName=graphControl}">
          <ToggleButton x:Name="gridVisibilityToggle" ToolTip="Show Grid" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Margin="5 0" Padding="4">
            <demo:PathIcon Width="16" Height="16" Geometry="{StaticResource IconGrid5x5}" Margin="0" />
          </ToggleButton>
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:SideBar x:Name="settingsPanel" Header="Grid Snapping Options">
      <StackPanel Margin="8">
        <StackPanel Margin="0">
          <TextBlock Text="Grid Snapping" Margin="0,0,0,4" />
          <RadioButton Content="None" GroupName="GridSnapType" Margin="0 0 0 2"
                       IsChecked="{Binding GridSnapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridSnapTypes.None}}" />
          <RadioButton Content="Horizontal Lines" GroupName="GridSnapType" Margin="0 2"
                       IsChecked="{Binding GridSnapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridSnapTypes.HorizontalLines}}" />
          <RadioButton Content="Vertical Lines" GroupName="GridSnapType" Margin="0 2"
                       IsChecked="{Binding GridSnapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridSnapTypes.VerticalLines}}" />
          <RadioButton Content="Lines" GroupName="GridSnapType" Margin="0 2"
                       IsChecked="{Binding GridSnapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridSnapTypes.Lines}}" />
          <RadioButton Content="Points" GroupName="GridSnapType" Margin="0 2"
                       IsChecked="{Binding GridSnapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridSnapTypes.GridPoints}}" />
          <RadioButton Content="All" GroupName="GridSnapType" Margin="0 2 0 0"
                       IsChecked="{Binding GridSnapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridSnapTypes.All}}" />
        </StackPanel>
        <StackPanel Margin="0 24 0 0 ">
          <TextBlock Text="Grid Appearance" Margin="0,0,0,4" />
          <StackPanel>
            <RadioButton Content="Dots" GroupName="GridStyle" Margin="0 0 0 2"
                         IsChecked="{Binding GridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridStyle.Dots}}" />
            <RadioButton Content="Lines" GroupName="GridStyle" Margin="0 2"
                         IsChecked="{Binding GridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridStyle.Lines}}" />
            <RadioButton Content="Horizontal Lines" GroupName="GridStyle" Margin="0 2"
                         IsChecked="{Binding GridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridStyle.HorizontalLines}}" />
            <RadioButton Content="Vertical Lines" GroupName="GridStyle" Margin="0 2"
                         IsChecked="{Binding GridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridStyle.VerticalLines}}" />
            <RadioButton Content="Crosses" GroupName="GridStyle" Margin="0 2 0 0"
                         IsChecked="{Binding GridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static ywpf:GridStyle.Crosses}}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Margin="0 8 0 0">
          <TextBlock Text="Color" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="black"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.Black}}">
              <Border Width="20" Height="20" Background="Black" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="gray"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.Gray}}">
              <Border Width="20" Height="20" Background="Gray" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="lightgray"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.LightGray}}">
              <Border Width="20" Height="20" Background="LightGray" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="darkorchid"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.DarkOrchid}}">
              <Border Width="20" Height="20" Background="DarkOrchid" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="navy"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.Navy}}">
              <Border Width="20" Height="20" Background="Navy" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="teal"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.Teal}}">
              <Border Width="20" Height="20" Background="Teal" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="firebrick"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.Firebrick}}">
              <Border Width="20" Height="20" Background="Firebrick" />
            </RadioButton>
            <RadioButton GroupName="GridColor" Style="{StaticResource ColorSwatchRadioButton}" ToolTip="sienna"
                         IsChecked="{Binding GridColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static media:Colors.Sienna}}">
              <Border Width="20" Height="20" Background="Sienna" />
            </RadioButton>
          </StackPanel>
          <StackPanel Margin="0 8 0 0">
            <TextBlock Text="Thickness" Margin="0,0,0,4" />
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Thickness}" Margin="8,0,0,0" VerticalAlignment="Center" />
              <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </demo:SideBar>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
