<demo:Demo x:Class="yWorks.Demo.Tooltips.TooltipsDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           xmlns:local="clr-namespace:yWorks.Demo.Tooltips">
  <demo:Demo.Resources>
    <local:NodeToTextConverter x:Key="NodeToTextConverter" />
    <Style TargetType="ToolTip" x:Key="{x:Static ywpf:ToolTipInputMode.ToolTipStyleKey}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <DataTemplate x:Key="TooltipContent">
      <Border Background="#85a1c2" BorderBrush="#85a1c2" BorderThickness="2" CornerRadius="5" Padding="6">
        <StackPanel>
          <TextBlock Text="Node Tooltip" FontWeight="Bold" FontSize="14" Foreground="White" Margin="2" />
          <TextBlock Text="{Binding Path=., Converter={StaticResource NodeToTextConverter}}" Foreground="White" Margin="2" />
          <TextBlock x:Name="Location" Text="" Foreground="White" Margin="2" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="PopoverContent">
      <Border Background="#809bb9" CornerRadius="5" Padding="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0"
                     Text="Popover" Foreground="White" FontSize="14"
                     VerticalAlignment="Center" />
          <Button Grid.Row="0" Grid.Column="1"
                  Command="{x:Static ywpf:PopoverDescriptor.ClosePopover}"
                  Content="×" Background="Transparent" Foreground="White" FontSize="20" Padding="2 0"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" />
          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding Path=., Converter={StaticResource NodeToTextConverter}}" Foreground="White" Margin="0 8" />
          <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Command="{Binding CloseAndDelete, RelativeSource={RelativeSource AncestorType=demo:Demo}}" CommandParameter="{Binding Path=.}"
                  Content="Delete Node" Foreground="Black"
                  HorizontalAlignment="Left"
                  Loaded="SetFocusOnLoaded"/>
        </Grid>
      </Border>
    </DataTemplate>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}" />
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:Description Background="White" Source="description.html" />
  </demo:DemoView>
</demo:Demo>
