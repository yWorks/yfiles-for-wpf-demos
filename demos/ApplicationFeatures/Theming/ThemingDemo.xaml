<demo:Demo x:Class="yWorks.Demo.Theming.ThemingDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:sys="clr-namespace:System;assembly=System.Runtime"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml">
  <demo:Demo.Resources>
    <!-- Define the theme variant, scale, and colors for both graph controls. -->
    <ywpf:ThemeVariant x:Key="{x:Static ywpf:CanvasControl.ThemeVariantKey}">Round</ywpf:ThemeVariant>
    <sys:Double x:Key="{x:Static ywpf:CanvasControl.ThemeScaleKey}">2</sys:Double>
    <SolidColorBrush x:Key="{x:Static ywpf:CanvasControl.ThemePrimaryBrushKey}">#030201</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static ywpf:CanvasControl.ThemeSecondaryBrushKey}">#f69454</SolidColorBrush>
    <SolidColorBrush x:Key="{x:Static ywpf:CanvasControl.ThemeBackgroundBrushKey}">#ee693f</SolidColorBrush>
  </demo:Demo.Resources>
  <demo:DemoView>
    <demo:ClippingBorder Style="{StaticResource DemoBorderStyle}">
      <DockPanel>
        <demo:DemoToolBar DockPanel.Dock="Top" ButtonPresets="Zoom, Editing" CommandTarget="{Binding ElementName=graphControl}">
          <Button Command="New" CommandTarget="{Binding ElementName=graphControl}" />
        </demo:DemoToolBar>
        <ywpf:GraphControl x:Name="graphControl" Background="White" />
      </DockPanel>
    </demo:ClippingBorder>
    <demo:FloatingButton Header="Overview" IsExpanded="True">
      <ywpf:GraphOverviewControl GraphControl="{Binding ElementName=graphControl}" />
    </demo:FloatingButton>
    <demo:Description Source="description.html" />
  </demo:DemoView>
</demo:Demo>
