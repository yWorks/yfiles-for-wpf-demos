<Application x:Class="DemoBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demo="clr-namespace:yWorks.Demo;assembly=DemoToolkit"
             xmlns:vm="clr-namespace:DemoBrowser.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DemoToolkit;component/Resources/yFilesDemoStyles.xaml" />
                <ResourceDictionary Source="/DemoToolkit;component/Icons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DemoCategory}">
                <TextBlock Text="{Binding Value}" />
            </DataTemplate>

            <Style x:Key="CardButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Width" Value="250" />
                <Setter Property="Height" Value="300" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <demo:ClippingBorder x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="ContentPresenter" Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Opacity="1" />
                                </demo:ClippingBorder>
                                <Border x:Name="FocusBorder" Margin="-2" BorderThickness="2" CornerRadius="14"
                                        IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ContentPresenter" Property="Opacity" Value="1"/>
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="1,1,1,2" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                    <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DemoCardTemplate">
                <Button x:Name="DemoCardButton" Style="{StaticResource CardButtonStyle}"
                    Command="{Binding DataContext.OpenDemoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Summary}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Image Source="{Binding Screenshot}" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.Row="0"/>

                        <TextBlock FontSize="18"
                                   Margin="20,8,20,8"
                                   Grid.Row="1"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary}" Grid.Row="2" Margin="20,0,24,20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
