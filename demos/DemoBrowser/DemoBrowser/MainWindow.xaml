<Window x:Class="DemoBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:demo="clr-namespace:yWorks.Demo;assembly=DemoToolkit"
        xmlns:controls="clr-namespace:DemoBrowser.Controls"
        mc:Ignorable="d"
        Title="yFiles WPF Demos"
        Icon="pack://application:,,,/DemoToolkit;component/Resources/yFiles.ico"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="540" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid x:Name="OverviewView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverview}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="24,16,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource yFilesWpf}" Height="40" Fill="{DynamicResource TextFillColorPrimaryBrush}" Stretch="Uniform">
                        <Path.RenderTransform>
                            <TranslateTransform Y="3"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Margin="8" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12" FontWeight="SemiBold" Text="&#xE974;" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold">Demos &amp; Tutorials</TextBlock>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4*" MinWidth="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:SearchBox Grid.Column="1"
                                        PlaceholderText="Search by demo name, tag, or keyword"
                                        Text="{Binding SearchText}"
                                        FilterItemsSource="{Binding Categories}"
                                        SelectedFilter="{Binding SelectedCategory}" />
                </Grid>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="DemoItemsControl" Margin="2" Focusable="False" ItemsSource="{Binding Demos}" ItemTemplate="{StaticResource DemoCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="DemoView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverview}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="24,16" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left"
                            Background="{DynamicResource SubtleFillColorTransparentBrush}"
                            BorderThickness="0"
                            Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}"
                            Margin="0,0,18,0"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16" Content="&#xE72B;"
                            Command="{Binding ShowOverviewCommand}"
                            VerticalAlignment="Bottom"
                            ToolTip="Back to demos"/>

                    <demo:Breadcrumbs VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold">
                        <demo:BreadcrumbItem IsEnabled="False">
                            <Path Data="{StaticResource yFilesWpf}" Height="40" Fill="{DynamicResource TextFillColorPrimaryBrush}" Stretch="Uniform">
                                <Path.RenderTransform>
                                    <TranslateTransform Y="3"/>
                                </Path.RenderTransform>
                            </Path>
                        </demo:BreadcrumbItem>
                        <demo:BreadcrumbItem Content="Demos" Command="{Binding ShowOverviewCommand}" />
                        <demo:BreadcrumbItem Content="{Binding SelectedDemo.Title}" IsEnabled="False" />
                    </demo:Breadcrumbs>
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding DemoView}" />
        </Grid>
    </Grid>
</Window>
