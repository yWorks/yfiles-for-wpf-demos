<demo:Demo x:Class="yWorks.Demo.DataBinding.AdjacencyGraphBuilder.AdjacencyGraphBuilderDemo"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:demo="http://www.yworks.com/xml/yfiles-demos"
           xmlns:ywpf="http://www.yworks.com/xml/yfiles-wpf/4.0/xaml"
           Background="White">
  <demo:DemoView>
    <ywpf:GraphControl x:Name="graphControl">
      <ywpf:GraphControl.InputMode>
        <ywpf:MoveViewportInputMode />
      </ywpf:GraphControl.InputMode>
    </ywpf:GraphControl>
    <demo:Description Source="description.html" />
    <demo:DemoToolBar ButtonPresets="Zoom" CommandTarget="{Binding ElementName=graphControl}">
      <ComboBox x:Name="graphSourceComboBox" Width="250" SelectionChanged="AdjacencyGraphBuilderModelChanged">
        <ComboBoxItem>Organization with Predecessor</ComboBoxItem>
        <ComboBoxItem>Organization with Successors</ComboBoxItem>
        <ComboBoxItem>Organization with Predecessor Id</ComboBoxItem>
        <ComboBoxItem>Organization with Successors Ids</ComboBoxItem>
      </ComboBox>
    </demo:DemoToolBar>
  </demo:DemoView>
</demo:Demo>
